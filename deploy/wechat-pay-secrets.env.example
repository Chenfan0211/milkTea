# =============================================================
# 微信支付（订单支付）配置 —— 追加到 /opt/wuling/app/secrets.env
#
# 用法：把下面整段追加到生产机的 /opt/wuling/app/secrets.env 末尾，
#       保持文件权限 600（deploy-backend.sh 的 preflight 会自动 chmod）。
#
# 备案状态：域名 api.wulingshiguang.top 尚未备案。
#   → PAY_CHANNEL 必须保持 mock，微信支付相关 Bean 不会被创建，
#     不会读取证书、不会向 api.mch.weixin.qq.com 发起任何请求。
#   → 备案通过后，把 PAY_CHANNEL 改为 wxpay 并重启 trade-service 即可。
#
# 安全约定：本文件是「占位模板」，真实密钥请填入生产机 secrets.env，
#           或参考 .tmp/wechat-pay-secrets.env（本地、不入库）。
#           禁止把任何 .pem 证书提交进 git 仓库。
# =============================================================

# ---------- 支付通道（备案前保持 mock；备案后改 wxpay）----------
PAY_CHANNEL=mock

# ---------- 商户资质 ----------
WXPAY_MCH_ID=<商户号>
WXPAY_APP_ID=<小程序AppID>

# ---------- 密钥与证书序列号 ----------
WXPAY_API_V3_KEY=<32位APIv3密钥>
WXPAY_MCH_SERIAL_NO=<商户证书序列号>

# ---------- 验签模式：微信支付公钥（新商户推荐，无需轮换平台证书）----------
WXPAY_VERIFY_MODE=public-key
WXPAY_PUBLIC_KEY_ID=<微信支付公钥ID，形如 PUB_KEY_ID_xxx>

# ---------- 证书文件路径（容器内路径，与 compose 挂载一致）----------
WXPAY_PRIVATE_KEY_PATH=/opt/wuling/app/certs/apiclient_key.pem
WXPAY_PUBLIC_KEY_PATH=/opt/wuling/app/certs/pub_key.pem

# ---------- 回调地址（必须 https + 已备案域名，备案通过后生效）----------
WXPAY_NOTIFY_URL=https://api.wulingshiguang.top/api/v1/app/payments/wxpay/notify
WXPAY_REFUND_NOTIFY_URL=https://api.wulingshiguang.top/api/v1/app/payments/wxpay/refund-notify
WXPAY_PAYOUT_NOTIFY_URL=https://api.wulingshiguang.top/api/v1/app/payout/notify
# =============================================================
# 小程序订阅消息（与微信支付相互独立）
#   - WX_APP_ID / WX_APP_SECRET 复用 user-service 的小程序登录配置（同一小程序）
#   - 模板 ID 是公开值，默认已写在 application.yml，可用环境变量覆盖
#   - application-dev.yml 默认关闭；生产 secrets.env 默认开启
#   - 若公众平台为 access_token 配置了 IP 白名单，需加入生产服务器出口 IP
# =============================================================
WX_ORDER_SUBSCRIBE_ENABLED=true
WX_ORDER_SUBSCRIBE_TEMPLATE_ID=W-_sFdE4DpQbfs5aeXASyEvVIVkFBYz65Qjl8lQQJWM
WX_ORDER_SUBSCRIBE_PAGE=pages/order-detail/order-detail
WX_ORDER_SUBSCRIBE_MINIPROGRAM_STATE=formal

# ---------- 营销订阅消息（marketing-service）----------
WX_MARKETING_SUBSCRIBE_ENABLED=true
WX_MARKETING_SUBSCRIBE_MINIPROGRAM_STATE=formal
WX_POINTS_CHANGE_TEMPLATE_ID=W69-LPXpDxs7pPiN_0I_75I0XqXJWPkL4XYCS26CopM
WX_POINTS_EXCHANGE_TEMPLATE_ID=6DKXp9_Bx4gYaj0CaUeTp6rXyKIF3AZrrmSR5CwHjfE
WX_STORED_VALUE_RECHARGE_TEMPLATE_ID=uvD7jHuIZ1bpXIA-HfqHXfScW0j2zIYBCYWHR7emFJI
WX_BALANCE_CHANGE_TEMPLATE_ID=uvD7jHuIZ1bpXIA-HfqHXQGw6MCweamgsPFK-MIVne0
WX_COUPON_ARRIVAL_TEMPLATE_ID=en0sN5PvHmq9DyiZIjaH_x5-bGpisdD3boCqMa_wx5g
WX_COUPON_EXPIRY_TEMPLATE_ID=oaeDu3ZTFfzrrPQvFliAMRHdMNg19KW2V8xhvCU5MSo
WX_COUPON_EXPIRY_ENABLED=true
WX_COUPON_EXPIRY_CRON=0 0 10 * * ?
WX_COUPON_EXPIRY_DAYS_BEFORE=3
WX_COUPON_EXPIRY_BATCH_SIZE=500
