# =============================================================
# 微信支付（订单支付）配置 —— 追加到 /opt/wuling/app/secrets.env
#
# 用法：把下面整段追加到生产机的 /opt/wuling/app/secrets.env 末尾，
#       保持文件权限 600（deploy-backend.sh 的 preflight 会自动 chmod）。
#
# 备案状态：域名 api.wulingshiguang.top 尚未备案。
#   → PAY_CHANNEL 必须保持 mock，微信支付相关 Bean 不会被创建，
#     不会读取证书、不会向 api.mch.weixin.qq.com 发起任何请求。
#   → 备案通过后，把 PAY_CHANNEL 改为 wxpay 并重启 trade-service 即可。
#
# 安全约定：本文件是「占位模板」，真实密钥请填入生产机 secrets.env，
#           或参考 .tmp/wechat-pay-secrets.env（本地、不入库）。
#           禁止把任何 .pem 证书提交进 git 仓库。
# =============================================================

# ---------- 支付通道（备案前保持 mock；备案后改 wxpay）----------
PAY_CHANNEL=mock

# ---------- 商户资质 ----------
WXPAY_MCH_ID=<商户号>
WXPAY_APP_ID=<小程序AppID>

# ---------- 密钥与证书序列号 ----------
WXPAY_API_V3_KEY=<32位APIv3密钥>
WXPAY_MCH_SERIAL_NO=<商户证书序列号>

# ---------- 验签模式：微信支付公钥（新商户推荐，无需轮换平台证书）----------
WXPAY_VERIFY_MODE=public-key
WXPAY_PUBLIC_KEY_ID=<微信支付公钥ID，形如 PUB_KEY_ID_xxx>

# ---------- 证书文件路径（容器内路径，与 compose 挂载一致）----------
WXPAY_PRIVATE_KEY_PATH=/opt/wuling/app/certs/apiclient_key.pem
WXPAY_PUBLIC_KEY_PATH=/opt/wuling/app/certs/pub_key.pem

# ---------- 回调地址（必须 https + 已备案域名，备案通过后生效）----------
WXPAY_NOTIFY_URL=https://api.wulingshiguang.top/api/v1/app/payments/wxpay/notify
WXPAY_REFUND_NOTIFY_URL=https://api.wulingshiguang.top/api/v1/app/payments/wxpay/refund-notify
WXPAY_PAYOUT_NOTIFY_URL=https://api.wulingshiguang.top/api/v1/app/payout/notify
