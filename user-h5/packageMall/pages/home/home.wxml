<view class="mall-page">
  <navigation-bar title="线上商城" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <scroll-view class="mall-scroll" scroll-y show-scrollbar="{{false}}" lower-threshold="120" bindscrolltolower="loadMore">
    <view class="home-content">
      <view class="home-hero">
        <view class="home-hero__copy">
          <text class="home-hero__eyebrow">五零时光精选</text>
          <text class="home-hero__title">把好物带回家</text>
          <text class="home-hero__description">全场包邮 · 库存实时更新</text>
        </view>
        <view class="home-hero__badge">
          <image class="home-hero__badge-icon" src="/assets/icons/lucide/shopping-bag.svg" mode="aspectFit" aria-label="商城图标" />
        </view>
      </view>

      <view class="home-quick-grid">
        <view class="home-quick-card" bindtap="openCart" aria-role="button" aria-label="打开购物车">
          <view class="home-quick-card__icon-wrap">
            <image class="home-quick-card__icon" src="/assets/icons/lucide/shopping-bag.svg" mode="aspectFit" />
          </view>
          <view class="home-quick-card__main">
            <text class="home-quick-card__title">购物车</text>
            <text class="home-quick-card__description">查看已选好物</text>
          </view>
          <image class="home-quick-card__arrow" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" />
        </view>

        <view class="home-quick-card" bindtap="openOrders" aria-role="button" aria-label="查看商城订单">
          <view class="home-quick-card__icon-wrap">
            <image class="home-quick-card__icon" src="/assets/icons/lucide/receipt.svg" mode="aspectFit" />
          </view>
          <view class="home-quick-card__main">
            <text class="home-quick-card__title">我的订单</text>
            <text class="home-quick-card__description">发货与售后进度</text>
          </view>
          <image class="home-quick-card__arrow" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" />
        </view>
      </view>

      <view class="home-section-head">
        <text class="home-section-title">商品分类</text>
        <text class="home-section-subtitle">轻养好物都在这里</text>
      </view>

      <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="category-list">
          <view
            wx:for="{{categories}}"
            wx:key="id"
            class="category-tab {{activeCategoryId === item.id ? 'is-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectCategory"
            aria-role="button"
            aria-label="筛选{{item.name}}"
          >
            <image
              class="category-tab__image"
              src="{{item.iconImage || '/assets/images/3x/mall-category-placeholder.jpg'}}"
              mode="aspectFill"
              aria-label="{{item.name}}分类图"
            />
            <text class="category-tab__label">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{loading}}" class="mall-state home-empty-card">
        <text class="home-empty-title">商品加载中</text>
        <text class="home-empty-description">正在为你准备轻养好物</text>
      </view>

      <view wx:elif="{{error}}" class="mall-state home-empty-card">
        <text class="home-empty-title">商品加载失败</text>
        <text class="home-empty-description">{{error}}</text>
        <view class="home-empty-action" bindtap="retry" aria-role="button" aria-label="重新加载商品">刷新看看</view>
      </view>

      <view wx:elif="{{products.length}}" class="product-grid">
        <view
          wx:for="{{products}}"
          wx:key="id"
          class="product-card {{item.soldOut ? 'is-sold-out' : ''}}"
          data-id="{{item.id}}"
          bindtap="openProduct"
          aria-role="button"
          aria-label="查看{{item.name}}{{item.soldOut ? '，已售罄' : ''}}"
        >
          <view class="product-card__image-wrap">
            <image class="product-card__image" src="{{item.image}}" mode="aspectFill" aria-label="{{item.name}}商品图" />
            <view wx:if="{{item.soldOut}}" class="product-card__sold-out">已售罄</view>
          </view>
          <view class="product-card__body">
            <text class="product-card__name">{{item.name}}</text>
            <text wx:if="{{item.subtitle}}" class="product-card__subtitle">{{item.subtitle}}</text>
            <view class="product-card__price-row">
              <text class="product-card__price">{{item.priceText}}</text>
              <text wx:if="{{item.originalPriceText}}" class="product-card__original">{{item.originalPriceText}}</text>
            </view>
            <view class="product-card__stock-row">
              <text class="product-card__stock">{{item.soldOut ? '暂时无货' : '可用库存 ' + item.availableStock}}</text>
              <image
                class="product-card__arrow"
                src="/assets/icons/lucide/chevron-right.svg"
                mode="aspectFit"
                aria-label="查看{{item.name}}详情"
              />
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="mall-state home-empty-card">
        <image class="home-empty-icon" src="/assets/icons/lucide/shopping-bag.svg" mode="aspectFit" aria-label="暂无商品图标" />
        <text class="home-empty-title">该分类暂无商品</text>
        <text class="home-empty-description">换个分类看看，或刷新最新上架</text>
        <view class="home-empty-action" bindtap="retry" aria-role="button" aria-label="重新加载商品">刷新看看</view>
      </view>

      <view wx:if="{{products.length}}" class="home-list-end">
        {{loadingMore ? '正在加载更多' : (hasMore ? '上拉加载更多' : '已经到底了')}}
      </view>
    </view>
  </scroll-view>
</view>
