<view class="mall-page">
  <navigation-bar title="线上商城" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <scroll-view class="mall-scroll" scroll-y show-scrollbar="{{false}}" lower-threshold="120" bindscrolltolower="loadMore">
    <view class="home-content">
      <view class="home-hero">
        <view class="home-hero__copy">
          <text class="home-hero__eyebrow">五零时光精选</text>
          <text class="home-hero__title">把好物带回家</text>
          <text class="home-hero__description">全场包邮，库存实时更新</text>
        </view>
        <view class="home-hero__tools">
          <view class="home-tool" bindtap="openCart" aria-role="button" aria-label="打开购物车">
            <image class="home-tool__icon" src="/assets/icons/lucide/shopping-bag.svg" mode="aspectFit" />
            <text class="home-tool__label">购物车</text>
          </view>
          <view class="home-tool" bindtap="openOrders" aria-role="button" aria-label="查看商城订单">
            <image class="home-tool__icon" src="/assets/icons/lucide/receipt.svg" mode="aspectFit" />
            <text class="home-tool__label">我的订单</text>
          </view>
        </view>
      </view>

      <text class="category-heading">商品分类</text>
      <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="category-list">
          <view
            wx:for="{{categories}}"
            wx:key="id"
            class="category-tab {{activeCategoryId === item.id ? 'is-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectCategory"
            aria-role="button"
            aria-label="筛选{{item.name}}"
          >{{item.name}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{loading}}" class="mall-state">
        <text class="mall-state__text">商品加载中</text>
      </view>

      <view wx:elif="{{error}}" class="mall-state">
        <text class="mall-state__text">{{error}}</text>
        <view class="mall-retry" bindtap="retry" aria-role="button" aria-label="重新加载商品">重新加载</view>
      </view>

      <view wx:elif="{{products.length}}" class="product-grid">
        <view
          wx:for="{{products}}"
          wx:key="id"
          class="product-card {{item.soldOut ? 'is-sold-out' : ''}}"
          data-id="{{item.id}}"
          bindtap="openProduct"
          aria-role="button"
          aria-label="查看{{item.name}}{{item.soldOut ? '，已售罄' : ''}}"
        >
          <view class="product-card__image-wrap">
            <image class="product-card__image" src="{{item.image}}" mode="aspectFill" aria-label="{{item.name}}商品图" />
            <view wx:if="{{item.soldOut}}" class="product-card__sold-out">已售罄</view>
          </view>
          <view class="product-card__body">
            <text class="product-card__name">{{item.name}}</text>
            <text wx:if="{{item.subtitle}}" class="product-card__subtitle">{{item.subtitle}}</text>
            <view class="product-card__price-row">
              <text class="product-card__price">{{item.priceText}}</text>
              <text wx:if="{{item.originalPriceText}}" class="product-card__original">{{item.originalPriceText}}</text>
            </view>
            <text class="product-card__stock">{{item.soldOut ? '暂时无货' : '可用库存 ' + item.availableStock}}</text>
          </view>
        </view>
      </view>

      <empty-state
        wx:else
        icon="/assets/icons/lucide/shopping-bag.svg"
        title="暂无商城商品"
        description="运营上架商品后会显示在这里"
      />

      <view wx:if="{{products.length}}" class="home-list-end">
        {{loadingMore ? '正在加载更多' : (hasMore ? '上拉加载更多' : '已经到底了')}}
      </view>
    </view>
  </scroll-view>
</view>

