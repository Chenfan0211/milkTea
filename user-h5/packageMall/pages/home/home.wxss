@import '../../styles/mall.wxss';

.home-fixed {
  flex: none;
  background: var(--card-bg);
}

.home-hero {
  position: relative;
  overflow: hidden;
  padding: 24rpx 20rpx 20rpx;
  background: linear-gradient(180deg, var(--brand-soft), var(--card-bg));
}

.home-hero__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-hero__watermark {
  flex: none;
  color: var(--brand-green);
  font-size: var(--font-display);
  font-weight: 600;
  opacity: 0.08;
  white-space: nowrap;
}

.home-hero__meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 8rpx;
}

.home-hero__title {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--text-main);
  font-size: var(--font-xl);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-hero__description {
  display: block;
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.home-order {
  display: flex;
  flex: none;
  align-items: center;
  height: 48rpx;
  margin-left: 16rpx;
  padding: 0 8rpx;
}

.home-order__icon {
  width: 32rpx;
  height: 32rpx;
}

.home-order__label {
  margin-left: 4rpx;
  color: var(--text-main);
  font-size: var(--font-sm);
}

.category-scroll {
  width: 100%;
  height: 144rpx;
  overflow: hidden;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  align-items: flex-start;
  padding: 0 20rpx;
}

.category-tab {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  width: calc((100vw - 88rpx) / 4);
  margin-right: 16rpx;
  padding: 12rpx 0;
  overflow: hidden;
  color: var(--text-secondary);
}

.category-tab:last-child {
  margin-right: 0;
}

.category-tab__image {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  background: var(--brand-soft);
  border-radius: var(--radius-md);
}

.category-tab__label {
  display: block;
  width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  color: inherit;
  font-size: var(--font-sm);
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-tab.is-active {
  color: var(--brand-green);
  font-weight: 600;
}

.home-products-scroll {
  flex: 1;
  min-height: 0;
}

.home-products-content {
  padding: 20rpx 20rpx 120rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
}

.product-card {
  width: calc((100% - 20rpx) / 2);
  margin-bottom: 20rpx;
  overflow: hidden;
  background: var(--card-bg);
  border-radius: var(--radius-md);
}

.product-card:nth-child(odd) {
  margin-right: 20rpx;
}

.product-card__image-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  background: var(--page-bg-neutral);
}

.product-card__image {
  width: 100%;
  height: 100%;
}

.product-card__sold-out {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 12rpx;
  color: var(--text-secondary);
  font-size: var(--font-caption);
  background: var(--card-bg);
  border-radius: var(--radius-xs);
}

.product-card__body {
  padding: 16rpx;
}

.product-card__name {
  display: block;
  overflow: hidden;
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card__stock {
  display: block;
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
}

.product-card__price-row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.product-card__price {
  color: var(--brand-green);
  font-size: var(--font-lg);
  font-weight: 600;
}

.product-card__original {
  margin-left: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption);
  text-decoration: line-through;
}

.product-card.is-sold-out .product-card__image {
  opacity: 0.56;
}

.product-card.is-sold-out .product-card__price {
  color: var(--text-muted);
}

.home-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
}

.home-empty-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.6;
}

.home-empty-title {
  margin-top: 20rpx;
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.home-empty-description {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  text-align: center;
}

.home-empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  height: 48rpx;
  margin-top: 24rpx;
  color: var(--card-bg);
  font-size: var(--font-sm);
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}

.home-list-end {
  padding: 20rpx 0;
  color: var(--text-muted);
  font-size: var(--font-sm);
  text-align: center;
}

.home-cart {
  position: fixed;
  right: 20rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  background: var(--card-bg);
  border-radius: 50%;
  box-shadow: var(--shadow-float);
}

.home-cart__icon {
  width: 40rpx;
  height: 40rpx;
}

.home-cart__badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  color: var(--card-bg);
  font-size: var(--font-caption);
  line-height: 32rpx;
  text-align: center;
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}
