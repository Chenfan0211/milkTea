@import '../../styles/mall.wxss';

.home-content {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.home-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--brand-soft);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.home-hero__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.home-hero__eyebrow {
  color: var(--brand-green);
  font-size: var(--font-caption);
  letter-spacing: 1rpx;
}

.home-hero__title {
  margin-top: 12rpx;
  color: var(--text-main);
  font-size: var(--font-display);
  font-weight: 600;
}

.home-hero__description {
  display: inline-flex;
  align-self: flex-start;
  margin-top: 20rpx;
  padding: 8rpx 16rpx;
  color: var(--brand-green);
  font-size: var(--font-caption);
  background: var(--brand-soft);
  border-radius: var(--radius-pill);
}

.home-hero__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 104rpx;
  height: 104rpx;
  margin-left: 20rpx;
  background: var(--brand-soft);
  border-radius: 50%;
}

.home-hero__badge-icon {
  width: 52rpx;
  height: 52rpx;
}

.home-quick-grid {
  display: flex;
  margin-top: 20rpx;
}

.home-quick-card {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--line-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.home-quick-card + .home-quick-card {
  margin-left: 12rpx;
}

.home-quick-card__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 64rpx;
  height: 64rpx;
  background: var(--brand-soft);
  border-radius: 50%;
}

.home-quick-card__icon {
  width: 32rpx;
  height: 32rpx;
}

.home-quick-card__main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 16rpx;
}

.home-quick-card__title {
  overflow: hidden;
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
  white-space: nowrap;
}

.home-quick-card__description {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: var(--font-caption);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home-quick-card__arrow {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}

.home-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
}

.home-section-title {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.home-section-subtitle {
  color: var(--text-muted);
  font-size: var(--font-caption);
}

.category-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  align-items: center;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 16rpx 0 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  background: var(--card-bg);
  border: 1rpx solid var(--line-color);
  border-radius: var(--radius-pill);
}

.category-tab + .category-tab {
  margin-left: 12rpx;
}

.category-tab__image {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--brand-soft);
}

.category-tab__label {
  margin-left: 8rpx;
  white-space: nowrap;
}

.category-tab.is-active {
  color: var(--text-main);
  background: var(--brand-green);
  border-color: var(--brand-green);
  box-shadow: var(--shadow-card);
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: calc(50% - 8rpx);
  margin-bottom: 20rpx;
  overflow: hidden;
  background: var(--card-bg);
  border: 1rpx solid var(--line-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.product-card__image-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
  background: var(--page-bg-neutral);
}

.product-card__image {
  width: 100%;
  height: 100%;
}

.product-card__sold-out {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 12rpx;
  color: var(--text-secondary);
  font-size: var(--font-caption);
  background: rgba(255, 255, 255, 0.88);
  border-radius: var(--radius-xs);
}

.product-card__body {
  padding: 20rpx;
}

.product-card__name,
.product-card__subtitle,
.product-card__price-row,
.product-card__stock-row {
  display: block;
}

.product-card__name {
  overflow: hidden;
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card__subtitle {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-card__price-row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.product-card__price {
  color: var(--brand-green);
  font-size: var(--font-lg);
  font-weight: 600;
}

.product-card__original {
  margin-left: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption);
  text-decoration: line-through;
}

.product-card__stock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line-color);
}

.product-card__stock {
  color: var(--text-muted);
  font-size: var(--font-caption);
}

.product-card__arrow {
  width: 28rpx;
  height: 28rpx;
}

.product-card.is-sold-out .product-card__image {
  opacity: 0.56;
}

.product-card.is-sold-out .product-card__price {
  color: var(--text-muted);
}

.home-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--line-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.home-empty-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.6;
}

.home-empty-title {
  margin-top: 20rpx;
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.home-empty-description {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  text-align: center;
}

.home-empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  height: 56rpx;
  margin-top: 24rpx;
  color: var(--text-main);
  font-size: var(--font-sm);
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}

.home-list-end {
  padding: 20rpx 0;
  color: var(--text-muted);
  font-size: var(--font-sm);
  text-align: center;
}
