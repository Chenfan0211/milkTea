<view class="mall-page">
  <navigation-bar title="确认订单" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <scroll-view class="mall-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="checkout-content">
      <view wx:if="{{needLogin}}" class="checkout-login">
        <empty-state icon="/assets/icons/lucide/receipt.svg" title="请先登录" description="登录后可以选择地址并提交订单" />
        <view class="mall-button mall-button--primary checkout-login__button" bindtap="goLogin" aria-role="button" aria-label="去登录">去登录</view>
      </view>

      <view wx:elif="{{loading}}" class="mall-state">
        <text class="mall-state__text">结算信息加载中</text>
      </view>

      <view wx:elif="{{error}}" class="mall-state">
        <text class="mall-state__text">{{error}}</text>
        <view class="mall-retry" bindtap="retry" aria-role="button" aria-label="重新加载结算信息">重新加载</view>
      </view>

      <block wx:else>
        <view wx:if="{{selectedAddress}}" class="mall-card checkout-address" bindtap="openAddressPicker" aria-role="button" aria-label="更换收货地址">
          <image class="checkout-address__icon" src="/assets/icons/lucide/map-pin.svg" mode="aspectFit" />
          <view class="checkout-address__main">
            <view class="checkout-address__head">
              <text class="checkout-address__name">{{selectedAddress.recipientName}}</text>
              <text class="checkout-address__phone">{{selectedAddress.phone}}</text>
              <text wx:if="{{selectedAddress.isDefault}}" class="mall-tag">默认</text>
            </view>
            <text class="checkout-address__text">{{selectedAddress.fullAddress}}</text>
          </view>
          <image class="checkout-address__arrow" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" />
        </view>

        <view wx:else class="mall-card checkout-address checkout-address--empty" bindtap="openAddressPicker" aria-role="button" aria-label="选择收货地址">
          <image class="checkout-address__icon" src="/assets/icons/lucide/map-pin.svg" mode="aspectFit" />
          <view class="checkout-address__main">
            <text class="checkout-address__empty-title">请选择收货地址</text>
            <text class="checkout-address__text">商品将寄送到你选择的地址</text>
          </view>
          <image class="checkout-address__arrow" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" />
        </view>

        <view class="mall-card checkout-goods">
          <text class="mall-section-title">商品清单</text>
          <view wx:for="{{items}}" wx:key="skuId" class="checkout-goods__item">
            <image class="checkout-goods__image" src="{{item.image}}" mode="aspectFill" aria-label="{{item.name}}商品图" />
            <view class="checkout-goods__main">
              <text class="checkout-goods__name">{{item.name}}</text>
              <text class="checkout-goods__spec">{{item.specValue}}</text>
              <view class="checkout-goods__meta">
                <text class="checkout-goods__price">{{item.unitPriceText}}</text>
                <text class="checkout-goods__quantity">x{{item.quantity}}</text>
              </view>
            </view>
          </view>
          <view class="mall-divider"></view>
          <view class="checkout-goods__summary">
            <text class="checkout-goods__summary-label">共 {{count}} 件</text>
            <text class="checkout-goods__summary-price">¥{{amountText}}</text>
          </view>
          <view wx:if="{{hasCommission}}" class="checkout-fee-note">
            <text class="checkout-fee-note__text">其中含分销服务费 ¥{{commissionText}}</text>
          </view>
        </view>

        <view class="mall-card checkout-payment">
          <text class="mall-section-title">支付方式</text>
          <view
            class="payment-option {{paymentMethod === 'WXPAY' ? 'is-active' : ''}}"
            data-method="WXPAY"
            bindtap="selectPayment"
            aria-role="button"
            aria-label="选择微信支付"
          >
            <image class="payment-option__icon" src="/assets/icons/lucide/qr-code.svg" mode="aspectFit" />
            <view class="payment-option__main">
              <text class="payment-option__title">微信支付</text>
              <text class="payment-option__hint">使用微信完成支付</text>
            </view>
            <view class="mall-check {{paymentMethod === 'WXPAY' ? 'mall-check--active' : ''}}">
              <image wx:if="{{paymentMethod === 'WXPAY'}}" class="mall-check__icon" src="/assets/icons/lucide/check.svg" mode="aspectFit" />
            </view>
          </view>
          <view
            class="payment-option {{paymentMethod === 'STORED_VALUE' ? 'is-active' : ''}}"
            data-method="STORED_VALUE"
            bindtap="selectPayment"
            aria-role="button"
            aria-label="选择余额支付"
          >
            <image class="payment-option__icon" src="/assets/icons/lucide/wallet.svg" mode="aspectFit" />
            <view class="payment-option__main">
              <text class="payment-option__title">余额支付</text>
              <text class="payment-option__hint">使用现有储值余额支付</text>
            </view>
            <view class="mall-check {{paymentMethod === 'STORED_VALUE' ? 'mall-check--active' : ''}}">
              <image wx:if="{{paymentMethod === 'STORED_VALUE'}}" class="mall-check__icon" src="/assets/icons/lucide/check.svg" mode="aspectFit" />
            </view>
          </view>
        </view>

        <view class="checkout-note">商城商品不参与会员折扣、储值立减、优惠券或积分抵扣，全场包邮。</view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && !error && !needLogin}}" class="mall-action-bar">
    <view class="checkout-bar">
      <view class="checkout-bar__summary">
        <text class="checkout-bar__count">共 {{count}} 件</text>
        <view class="checkout-bar__amount-row">
          <text class="checkout-bar__label">应付</text>
          <text class="checkout-bar__amount">¥{{amountText}}</text>
        </view>
      </view>
      <view
        class="mall-button mall-button--primary checkout-bar__submit {{items.length && selectedAddress && !submitting ? '' : 'mall-button--disabled'}}"
        bindtap="submitOrder"
        aria-role="button"
        aria-label="提交商城订单"
      >{{submitting ? '提交中' : '提交订单'}}</view>
    </view>
  </view>
</view>
