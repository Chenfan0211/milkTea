.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10000;
  display: flex;
  box-sizing: border-box;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 10rpx 12rpx env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #ECEDE8;
}

.tabbar__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #9B9B96;
  text-decoration: none;
  pointer-events: auto;
}

.tabbar__item.is-active {
  color: #53882C;
}

.tabbar__icon {
  width: 48rpx;
  height: 48rpx;
}

.tabbar__label {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 30rpx;
}
