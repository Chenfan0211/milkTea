.function-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg);
}

.function-scroll {
  flex: 1;
  min-height: 0;
}

.function-empty {
  padding: 20rpx;
}

.function-content {
  padding: 24rpx var(--page-gutter) calc(40rpx + env(safe-area-inset-bottom));
}

.function-section {
  margin-top: 20rpx;
}

.function-section__title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
  line-height: 40rpx;
}

.function-card {
  padding: 8rpx 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.function-empty-text {
  display: block;
  padding: 24rpx 0;
  color: var(--text-muted);
  font-size: var(--font-sm);
  text-align: center;
}

.function-note {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 36rpx;
  background: var(--page-bg-neutral);
  border-radius: var(--radius-sm);
}

.record-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line-color);
}

.record-row:last-child {
  border-bottom: none;
}

.record-row__image {
  flex: none;
  width: 120rpx;
  height: 120rpx;
  margin-right: 16rpx;
  background: var(--page-bg);
  border-radius: var(--radius-sm);
}

.record-row__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.record-row__title {
  color: var(--text-main);
  font-size: var(--font-base);
  line-height: 36rpx;
}

.record-row__meta {
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
}

.record-row__time {
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 32rpx;
}

.record-row__amount {
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.record-row__status {
  color: var(--brand-green);
  font-size: var(--font-sm);
}
.verify-tabs {
  display: flex;
  margin-bottom: 16rpx;
  background: var(--page-bg-neutral);
  border-radius: var(--radius-pill);
  padding: 4rpx;
}

.verify-tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  color: var(--text-secondary);
  font-size: var(--font-md);
  border-radius: var(--radius-pill);
}

.verify-tab.is-active {
  color: #ffffff;
  font-weight: 600;
  background: var(--brand-green);
}

.record-row__head {
  display: flex;
  align-items: center;
}

.record-row__type {
  flex: none;
  margin-left: 8rpx;
  padding: 4rpx 12rpx;
  color: var(--brand-green);
  font-size: var(--font-caption);
  background: var(--tag-light-bg);
  border-radius: var(--radius-pill);
}

.record-row__type.is-exchange {
  color: var(--accent-orange);
  background: var(--tag-hot-bg);
}

.verify-entry {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.verify-entry__scan {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
}

.verify-entry__icon {
  width: 56rpx;
  height: 56rpx;
}

.verify-entry__label {
  margin-top: 8rpx;
  color: var(--brand-green);
  font-size: var(--font-sm);
}

.verify-entry__divider {
  flex: none;
  width: 1rpx;
  height: 72rpx;
  margin: 0 24rpx;
  background: var(--line-color);
}

.verify-entry__input {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.verify-entry__field {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 20rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  background: var(--page-bg-neutral);
  border-radius: var(--radius-sm);
}

.verify-entry__query {
  flex: none;
  margin-left: 12rpx;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: var(--font-sm);
  line-height: 64rpx;
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}
