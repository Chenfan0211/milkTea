.onboard-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background-color: var(--page-bg);
}

.onboard-scroll {
  flex: 1;
  min-height: 0;
}

.onboard-empty {
  padding: 120rpx var(--page-gutter);
}

.onboard-body {
  padding: var(--space-lg) var(--page-gutter) 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 结果态 ---------- */
.onboard-result {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 40rpx var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.onboard-result__icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.onboard-result__icon {
  width: 48rpx;
  height: 48rpx;
}

.onboard-result__title {
  margin-top: var(--space-lg);
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-main);
}

.onboard-result__desc {
  margin-top: var(--space-sm);
  font-size: var(--font-caption);
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
}

.onboard-result__actions {
  margin-top: var(--space-lg);
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

/* ---------- 提示条 ---------- */
.onboard-alert {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  padding: var(--space-md);
  background-color: var(--brand-soft);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
}

.onboard-alert__icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.onboard-alert__text {
  flex: 1;
  font-size: var(--font-caption);
  color: var(--text-main);
  line-height: 1.6;
}

/* ---------- 分区 ---------- */
.onboard-section {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
}

.onboard-section__title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-main);
}

.onboard-section__hint {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-caption);
  color: var(--text-muted);
  line-height: 1.6;
}

/* ---------- 主体类型 ---------- */
.onboard-types {
  margin-top: var(--space-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.onboard-type {
  border: 2rpx solid var(--line-color);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.onboard-type.is-active {
  border-color: var(--brand-green);
  background-color: var(--brand-tint);
}

.onboard-type__label {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
}

.onboard-type__desc {
  font-size: var(--font-caption);
  color: var(--text-muted);
  line-height: 1.5;
}

/* ---------- 表单字段 ---------- */
.onboard-field {
  margin-top: var(--space-md);
}

.onboard-field__label {
  display: block;
  font-size: var(--font-caption);
  color: var(--text-secondary);
  margin-bottom: var(--space-xs);
}

.onboard-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--space-md);
  box-sizing: border-box;
  background-color: var(--page-bg-neutral);
  border-radius: var(--radius-sm);
  font-size: var(--font-body);
  color: var(--text-main);
}

.onboard-input__placeholder {
  color: var(--text-muted);
}

/* ---------- 上传 ---------- */
.onboard-upload {
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-sm);
  background-color: var(--page-bg-neutral);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.onboard-upload__preview {
  width: 100%;
  height: 100%;
}

.onboard-upload__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
}

.onboard-upload__icon {
  width: 48rpx;
  height: 48rpx;
}

.onboard-upload__text {
  font-size: var(--font-caption);
  color: var(--text-muted);
}

/* ---------- 底部 ---------- */
.onboard-footnote {
  padding: 0 var(--space-xs) var(--space-md);
  font-size: var(--font-caption);
  color: var(--text-muted);
  line-height: 1.6;
}

.onboard-submit {
  height: 96rpx;
  border-radius: var(--radius-pill);
  background-color: var(--brand-green);
  color: #ffffff;
  font-size: var(--font-body);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.onboard-submit.is-disabled {
  background-color: var(--line-color);
  color: var(--text-muted);
}

/* ---------- 通用按钮 ---------- */
.onboard-btn {
  height: 88rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-body);
  font-weight: 600;
}

.onboard-btn--primary {
  background-color: var(--brand-green);
  color: #ffffff;
}

.onboard-btn--ghost {
  background-color: var(--page-bg-neutral);
  color: var(--text-secondary);
}
