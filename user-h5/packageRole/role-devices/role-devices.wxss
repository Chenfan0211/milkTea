/* 门店经营角色 · 设备管理（只读）：三段式固定型骨架（固定头部 + 独立滚动区） */
.devices-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg-neutral);
}

.devices-toolbar {
  flex: none;
  padding: 20rpx var(--page-gutter);
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--line-color);
}

.devices-toolbar__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.devices-toolbar__text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.devices-toolbar__summary {
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.devices-toolbar__updated {
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
}

.devices-toolbar__refresh {
  display: flex;
  flex: none;
  align-items: center;
  height: 56rpx;
  margin-left: 16rpx;
  padding: 0 20rpx;
  background: var(--brand-soft);
  border-radius: var(--radius-pill);
}

.devices-toolbar__refresh-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.devices-toolbar__refresh-text {
  color: var(--brand-green);
  font-size: var(--font-sm);
}

.devices-scroll {
  flex: 1;
  min-height: 0;
}

.devices-scroll__inner {
  padding: 20rpx var(--page-gutter) 0;
}

.devices-loading,
.devices-error {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
}

.devices-loading__text,
.devices-error__text {
  color: var(--text-secondary);
  font-size: var(--font-base);
}

.devices-error {
  flex-direction: column;
}

.devices-error__action {
  margin-top: 16rpx;
  color: var(--brand-green);
  font-size: var(--font-base);
  font-weight: 600;
}

.devices-list {
  display: flex;
  flex-direction: column;
}

.device-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
}

.device-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-card__name {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.device-card__status {
  flex: none;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-sm);
}

.device-card__status--online {
  color: var(--brand-green);
  background: var(--brand-soft);
}

.device-card__status--offline,
.device-card__status--unknown {
  color: var(--text-muted);
  background: var(--page-bg-neutral);
}

.device-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.device-card__label {
  flex: none;
  margin-right: 20rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
}

.device-card__value {
  flex: 1;
  min-width: 0;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  text-align: right;
}

.devices-end {
  padding: 20rpx 0;
  color: var(--text-muted);
  font-size: var(--font-sm);
  text-align: center;
}

.devices-safe {
  height: calc(20rpx + env(safe-area-inset-bottom));
}

.device-card__entry {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-color);
}

.device-card__entry-text {
  margin-right: 8rpx;
  color: var(--brand-green);
  font-size: var(--font-sm);
  font-weight: 600;
}

.device-card__entry-icon {
  width: 28rpx;
  height: 28rpx;
}
