.products-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg-neutral);
}

/* 工具栏 */
.products-toolbar {
  flex: none;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--line-color);
}

.products-search {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin: 20rpx var(--page-gutter) 16rpx;
  padding: 0 20rpx;
  background: var(--page-bg-neutral);
  border-radius: var(--radius-pill);
}

.products-search__icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.products-search__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: var(--text-main);
  font-size: var(--font-base);
}

.products-search__placeholder {
  color: var(--text-muted);
  font-size: var(--font-base);
}

.products-search__clear {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-left: 8rpx;
}

.products-search__clear-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 分类筛选：胶囊横滑，显式高度避免 Skyline 下高度塌陷 */
.products-tabs-scroll {
  width: 100%;
  height: 76rpx;
  overflow: hidden;
}

.products-tabs {
  display: inline-flex;
  align-items: center;
  height: 76rpx;
  padding: 0 var(--page-gutter);
  white-space: nowrap;
}

.products-tab {
  flex: none;
  height: 56rpx;
  margin-right: 12rpx;
  padding: 0 24rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 56rpx;
  white-space: nowrap;
  background: var(--page-bg-neutral);
  border-radius: var(--radius-pill);
}

.products-tab:last-child {
  margin-right: 0;
}

.products-tab.is-active {
  color: var(--card-bg);
  font-weight: 600;
  background: var(--brand-green);
}

/* 状态筛选：下划线 Tab，与提现 / 收益记录页保持一致，避免胶囊圆角溢出遮挡文字 */
.products-status {
  display: flex;
  margin-top: 12rpx;
  padding: 0 var(--page-gutter);
  overflow: hidden;
  border-bottom: 1rpx solid var(--line-color);
}

.products-status__item {
  position: relative;
  flex: 1;
  height: 80rpx;
  color: var(--text-secondary);
  font-size: var(--font-md);
  line-height: 80rpx;
  text-align: center;
}

.products-status__item.is-empty {
  color: var(--text-muted);
}

.products-status__item.is-active {
  color: var(--brand-green);
  font-weight: 600;
}

.products-status__item.is-active::after {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 40rpx;
  height: 4rpx;
  background: var(--brand-green);
  border-radius: var(--radius-pill);
  content: '';
  transform: translateX(-50%);
}

/* 统计行独立成行，与上方 tab 保持间距 */
.products-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx var(--page-gutter);
}

.products-summary__text {
  flex: 1;
  min-width: 0;
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 32rpx;
}

.products-summary__clear {
  flex: none;
  margin-left: 16rpx;
  color: var(--brand-green);
  font-size: var(--font-sm);
}

/* 列表 */
.products-scroll {
  flex: 1;
  min-height: 0;
}

.products-list {
  padding: 20rpx var(--page-gutter);
}

.product-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.product-row.is-selected {
  background: var(--brand-soft);
}

.product-row__check {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border: 2rpx solid var(--line-color);
  border-radius: 50%;
}

.product-row__check.is-checked {
  background: var(--brand-green);
  border-color: var(--brand-green);
}

.product-row__check-icon {
  width: 26rpx;
  height: 26rpx;
}

.product-row__image {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-sm);
}

.product-row__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.product-row__name {
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 40rpx;
}

.product-row__meta {
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 32rpx;
}

.product-row__foot {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.product-row__price {
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
}

.product-row__badge {
  flex: none;
  margin-left: 12rpx;
  padding: 0 8rpx;
  font-size: var(--font-caption);
  line-height: 28rpx;
  border-radius: var(--radius-xs);
}

.product-row__badge.is-listed {
  color: var(--brand-green);
  background: var(--brand-soft);
}

.product-row__badge.is-unlisted {
  color: var(--accent-orange);
  background: var(--tag-gold-bg);
}

.product-row__arrow {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
}

/* 上下架开关 */
.product-row__switch {
  position: relative;
  flex: none;
  width: 88rpx;
  height: 48rpx;
  margin-left: 16rpx;
  border-radius: var(--radius-pill);
}

.product-row__switch.is-on {
  background: var(--brand-green);
}

.product-row__switch.is-off {
  background: var(--line-color);
}

.product-row__switch-knob {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--card-bg);
  border-radius: 50%;
}

.product-row__switch.is-on .product-row__switch-knob {
  left: 46rpx;
}

.products-safe {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* 批量操作条 */
.products-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx var(--page-gutter) calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top: 1rpx solid var(--line-color);
}

.products-bar__info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-right: 20rpx;
}

.products-bar__count {
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
}

.products-bar__hint {
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: var(--font-caption);
}

.products-bar__actions {
  display: flex;
  flex: none;
}

.products-bar__button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 32rpx;
  font-size: var(--font-base);
  border-radius: var(--radius-pill);
}

.products-bar__button--secondary {
  color: var(--text-main);
  background: var(--card-bg);
  border: 2rpx solid var(--line-color);
}

.products-bar__button--primary {
  margin-left: 16rpx;
  color: var(--card-bg);
  background: var(--brand-green);
}