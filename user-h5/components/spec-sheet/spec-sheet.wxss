.spec-sheet-root {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
}

.spec-sheet__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.56);
}

.spec-sheet__panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  height: 88vh;
  overflow: hidden;
  background: var(--card-bg);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.spec-sheet__top-actions {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  z-index: 2;
  display: flex;
  gap: 16rpx;
}

.spec-sheet__circle-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  background: var(--page-bg-neutral);
  border-radius: 50%;
}

.spec-sheet__circle-icon {
  width: 34rpx;
  height: 34rpx;
}

/* 滚动区吃掉 panel 内除底部操作栏外的全部剩余高度。
   不再写死「88vh - 200rpx」去猜操作栏高度：action 是 flex:none 由内容撑开，
   两者口径一旦不一致，底部就会残留空白（edit 模式内容短时尤其明显）。
   min-height:0 是 flex 滚动容器的必要项，否则内容会撑破父级而不产生滚动。 */
.spec-sheet__scroll {
  flex: 1;
  min-height: 0;
}

.spec-sheet__hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 20rpx;
}

.spec-sheet__hero-media {
  position: relative;
}

.spec-sheet__hero-image {
  width: 480rpx;
  height: 440rpx;
}

.spec-sheet__hero-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 34rpx;
  height: 34rpx;
}

.spec-sheet__image-note {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption);
  line-height: 28rpx;
}

/* 让内容区至少撑满滚动容器：scroll-view 是 flex:1 拿走剩余高度，但内部内容
   height:auto 不会自动填满，内容短（edit 模式无商品大图）时底部就会残留空白。
   min-height:100% 取「内容自然高度」与「滚动区可视高度」的较大值：
   内容短 → 撑满无空白；内容长 → 正常滚动，行为不变。 */
.spec-sheet__content {
  min-height: 100%;
  padding: 0 var(--page-gutter) 40rpx;
}

.spec-sheet__content--edit {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.spec-sheet__name {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: var(--text-main);
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 54rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-sheet__name--edit {
  flex: none;
  width: 100%;
  padding-right: 152rpx;
}

.spec-sheet__title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.spec-sheet__feature-tag {
  flex-shrink: 0;
  padding: 4rpx 8rpx;
  color: var(--brand-green);
  background: var(--brand-soft);
  font-size: var(--font-sm);
  line-height: 30rpx;
  border-radius: var(--radius-xs);
}

.spec-sheet__description {
  display: block;
  margin-top: 20rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  line-height: 42rpx;
}

.spec-sheet__description--secondary {
  margin-top: 0;
}

.spec-sheet__info-block {
  margin-top: 24rpx;
}

.spec-sheet__info-title,
.spec-sheet__info-text {
  display: block;
  color: var(--text-secondary);
  font-size: var(--font-base);
  line-height: 42rpx;
}

.spec-sheet__expand {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: var(--text-main);
  font-size: var(--font-base);
}

.spec-sheet__expand-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  transition: transform 0.2s;
}

.spec-sheet__expand-icon.is-expanded {
  transform: rotate(180deg);
}

.spec-sheet__tip {
  margin-top: 16rpx;
  color: var(--text-muted);
  font-size: var(--font-caption);
  line-height: 34rpx;
}

.spec-sheet__tip-label {
  margin-right: 8rpx;
  color: var(--text-muted);
  font-weight: 600;
}

.spec-sheet__tip-text {
  color: var(--text-muted);
}

.spec-group {
  margin-top: 24rpx;
}

.spec-group__label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text-main);
  font-size: var(--font-base);
}

.spec-group__options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-option {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 20rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  background: var(--page-bg-neutral);
  border-radius: var(--radius-sm);
}

.spec-option.is-selected {
  color: #ffffff;
  background: var(--brand-green);
}

.spec-option__icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}

.spec-option__delta {
  margin-left: 8rpx;
  color: var(--price-red);
}

.spec-option.is-selected .spec-option__delta {
  color: #ffffff;
}
.spec-sheet__action {
  flex: none;
  padding: 16rpx var(--page-gutter) calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top: 1rpx solid var(--line-color);
}

.spec-sheet__summary {
  display: flex;
  align-items: center;
  min-height: 96rpx;
}

.spec-sheet__summary-info {
  flex: 1;
  min-width: 0;
}

.spec-sheet__summary-line {
  display: flex;
  align-items: center;
}

.spec-sheet__summary-price {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.spec-sheet__member-symbol {
  color: var(--text-main);
  font-size: var(--font-sm);
  font-weight: 600;
}

.spec-sheet__member-price {
  color: var(--text-main);
  font-size: var(--font-xl);
  font-weight: 600;
}

.spec-sheet__member-label {
  margin-right: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption);
}

.spec-sheet__estimate-line {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.spec-sheet__estimate-label {
  color: var(--brand-green);
  font-size: var(--font-caption);
}

.spec-sheet__estimate-symbol {
  margin-left: 4rpx;
  color: var(--brand-green);
  font-size: var(--font-caption);
}

.spec-sheet__estimate-price {
  color: var(--brand-green);
  font-size: var(--font-sm);
  font-weight: 600;
}

.spec-sheet__estimate-icon {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.spec-sheet__summary-original {
  margin-left: 12rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
  text-decoration: line-through;
}

.spec-sheet__favorite {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-left: 12rpx;
}

.spec-sheet__favorite-icon {
  width: 34rpx;
  height: 34rpx;
}

.spec-sheet__favorite--inline {
  width: 40rpx;
  height: 40rpx;
  margin-right: 4rpx;
  margin-left: 0;
}

.spec-sheet__spec-text {
  display: block;
  flex: 1;
  min-width: 0;
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-sheet__spec-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.spec-sheet__spec-line .spec-sheet__spec-text {
  margin-top: 4rpx;
}

.spec-sheet__stepper {
  display: flex;
  flex: none;
  align-items: center;
  height: 64rpx;
  margin-left: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--line-color);
  border-radius: var(--radius-sm);
}

.spec-sheet__step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.spec-sheet__step--minus.is-disabled {
  opacity: 0.35;
}

.spec-sheet__step--plus {
  background: var(--brand-green);
}

.spec-sheet__step-icon {
  width: 34rpx;
  height: 34rpx;
}

.spec-sheet__quantity {
  width: 64rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  text-align: center;
}

.spec-sheet__buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.spec-sheet__button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  font-size: var(--font-lg);
  font-weight: 600;
  border-radius: var(--radius-pill);
}

.spec-sheet__button--secondary {
  color: var(--brand-green);
  background: var(--card-bg);
  border: 2rpx solid var(--brand-green);
}

.spec-sheet__button--primary {
  color: #ffffff;
  background: var(--brand-green);
}

.spec-sheet__button--confirm {
  flex: none;
  width: 100%;
  margin-top: 16rpx;
  color: #ffffff;
  background: var(--brand-green);
}

.spec-sheet__taste-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 3;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  color: #ffffff;
  font-size: var(--font-base);
  background: rgba(0, 0, 0, 0.68);
  border-radius: var(--radius-pill);
  transform: translate(-50%, -50%);
}

.spec-sheet__taste-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
}
