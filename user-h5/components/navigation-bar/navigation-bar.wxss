.weui-navigation-bar {
  --weui-FG-0: var(--text-main);
  position: relative;
  z-index: 10;
  flex: none;
  overflow: hidden;
  color: var(--weui-FG-0);
}

.weui-navigation-bar.nav--transparent {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
}

.weui-navigation-bar__inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}

.weui-navigation-bar__left {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  padding-left: 16rpx;
  box-sizing: border-box;
}

.weui-navigation-bar__center {
  position: absolute;
  right: 180rpx;
  left: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
}

.weui-navigation-bar__right {
  position: absolute;
  right: 0;
}

.weui-navigation-bar__btn_goback_wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 100%;
}

.weui-navigation-bar__btn_goback_wrapper.weui-active {
  opacity: 0.5;
}

.weui-navigation-bar__btn_goback {
  flex: none;
  width: 48rpx;
  height: 48rpx;
}

.weui-navigation-bar__loading {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
}

.weui-loading {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(47, 48, 45, 0.18);
  border-top-color: currentColor;
  border-radius: 50%;
  animation: loading linear infinite 1s;
}

@keyframes loading {
  from {
    transform: rotate(0);
  }
  to {
    transform: rotate(360deg);
  }
}
