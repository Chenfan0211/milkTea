/*
 * 全屏固定层。
 *
 * 注意（Skyline 踩坑）：本组件必须由页面侧 `wx:if` 控制是否渲染。
 * 若只在组件内部用 `wx:if`，Skyline 的 glass-easel 仍会为自定义组件宿主节点
 * 保留占位，fixed 全屏层会拦住整页点击（表现为页面所有按钮点了没反应）。
 * 这里额外显式声明 pointer-events，避免任何情况下误吞事件。
 */
.login-sheet-root {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 12000;
  pointer-events: auto;
}

.login-sheet__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.46);
}

/*
 * 底部登录面板：贴屏幕底 + 只做上圆角（避免脱离底边后四角圆角呈「椭圆胶囊」观感）。
 * 底部内边距含 --tabbar-height：自定义 TabBar 是框架独立渲染层，其层叠不受页面 z-index 控制，
 * 必须靠留白把它让开，否则最下方的协议区会被 TabBar 盖住。
 */
.login-sheet__panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx calc(var(--tabbar-height) + 32rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  box-shadow: var(--shadow-card);
  /* 88rpx 为面板顶部与屏幕顶部之间的最小呼吸留白，保证面板不顶满整屏 */
  max-height: calc(100vh - 88rpx - env(safe-area-inset-bottom));
  overflow: hidden;
}

/* 内容滚动容器：面板限高后，内容超出时内部滚动，保证协议区始终可见 */
.login-sheet__body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

/* 品牌区：绿色圆形 logo + 标题 + 副标题 */
.login-sheet__brand {
  display: flex;
  flex-direction: column;
}

.login-sheet__logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}

.login-sheet__logo-icon {
  width: 52rpx;
  height: 52rpx;
}

.login-sheet__title {
  margin-top: 24rpx;
  color: var(--text-main);
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 56rpx;
}

.login-sheet__subtitle {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-base);
  line-height: 44rpx;
}

/* 按钮区：主次操作纵向铺满，保持同一视觉宽度 */
.login-sheet__actions {
  display: flex;
  flex-direction: column;
  width: 100%;
  margin-top: 40rpx;
}

/*
 * 原生 <button> 在微信用「内置样式」参与布局，其固有宽度会抵抗 width:100%，
 * 导致主按钮比跳过按钮（普通 view）窄。这里改用容器 flex + 按钮 flex:1 撑满，
 * 与 pages/auth-login 原生授权按钮的可用写法保持一致。
 */
.login-sheet__primary-wrap {
  display: flex;
  width: 100%;
}

/* 主按钮：实心绿胶囊 */
.login-sheet__primary {
  display: flex;
  flex: 1;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 88rpx;
  margin: 0;
  padding: 0;
  color: var(--card-bg);
  font-size: var(--font-lg);
  font-weight: 600;
  line-height: 1;
  background: var(--brand-green);
  border: none;
  border-radius: var(--radius-pill);
}

.login-sheet__primary::after {
  border: none;
}

.login-sheet__primary-text {
  color: var(--card-bg);
  font-size: var(--font-lg);
  font-weight: 600;
}

/* 次按钮：白底绿描边胶囊 */
.login-sheet__skip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 20rpx;
  color: var(--brand-green);
  font-size: var(--font-lg);
  font-weight: 600;
  background: var(--card-bg);
  border: 2rpx solid var(--brand-green);
  border-radius: var(--radius-pill);
}

/* 协议勾选 */
.login-sheet__consent {
  display: flex;
  align-items: flex-start;
  margin-top: 32rpx;
}

.login-sheet__box {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  border: 2rpx solid var(--text-muted);
  border-radius: var(--radius-pill);
}

.login-sheet__box.is-checked {
  background: var(--brand-green);
  border-color: var(--brand-green);
}

.login-sheet__check {
  width: 26rpx;
  height: 26rpx;
}

.login-sheet__consent-text {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 40rpx;
}

.login-sheet__link {
  color: var(--brand-green);
}
