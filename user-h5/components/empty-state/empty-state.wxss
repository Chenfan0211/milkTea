.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 560rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-state__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  color: var(--brand-green);
  font-size: var(--font-display);
  font-weight: 600;
  background: var(--brand-tint);
  border-radius: 50%;
}

.empty-state__icon--illustration {
  width: 320rpx;
  height: 260rpx;
  background: transparent;
  border-radius: 0;
}

.empty-state__image {
  width: 100%;
  height: 100%;
}

.empty-state__title {
  margin-top: 32rpx;
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.empty-state__description {
  max-width: 520rpx;
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 34rpx;
}
