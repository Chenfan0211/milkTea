.product-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 232rpx;
  padding: 16rpx 0;
}

.product-card.has-divider::after {
  position: absolute;
  left: 168rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--line-color);
  content: '';
}

.product-card__media {
  position: relative;
  flex: none;
  width: 150rpx;
  height: 200rpx;
  margin-right: 16rpx;
}

.product-card__image {
  width: 150rpx;
  height: 200rpx;
}

.product-card__badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 34rpx;
  height: 34rpx;
}

.product-card__content {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.product-card__name {
  color: var(--text-main);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.product-card__tags {
  display: flex;
  align-items: center;
  height: 22rpx;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
}

.product-card__tag {
  margin-right: 8rpx;
  padding: 0 4rpx;
  font-size: var(--font-caption);
  line-height: 22rpx;
}

.product-card__tag--hot {
  color: var(--price-red);
  background: var(--tag-hot-bg);
}

.product-card__tag--light {
  color: var(--tag-light-text);
  background: var(--tag-light-bg);
}

.product-card__description {
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: 20rpx;
  line-height: 26rpx;
  white-space: normal;
  word-break: break-all;
}

.product-card__footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 16rpx;
}

.product-card__price-block {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.product-card__price-row {
  display: flex;
  align-items: baseline;
  flex-wrap: nowrap;
  white-space: nowrap;
}

.product-card__price-row--sub {
  margin-top: 4rpx;
}

.product-card__price-label {
  color: var(--text-muted);
  font-size: var(--font-caption);
  line-height: 24rpx;
  white-space: nowrap;
}

.product-card__price-symbol {
  margin-left: 4rpx;
  color: var(--price-red);
  font-size: var(--font-caption);
  line-height: 36rpx;
  white-space: nowrap;
}

.product-card__price {
  color: var(--price-red);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 36rpx;
  white-space: nowrap;
}

.product-card__original {
  margin-left: 8rpx;
  color: var(--text-muted);
  font-size: 28rpx;
  line-height: 34rpx;
  text-decoration: line-through;
  white-space: nowrap;
}

.product-card__price-sub-label {
  color: var(--brand-green);
  font-size: var(--font-caption);
  line-height: 24rpx;
  white-space: nowrap;
}

.product-card__price-sub-symbol {
  margin-left: 4rpx;
  color: var(--brand-green);
  font-size: var(--font-caption);
  line-height: 32rpx;
  white-space: nowrap;
}

.product-card__price-sub {
  color: var(--brand-green);
  font-size: var(--font-sm);
  font-weight: 600;
  line-height: 32rpx;
  white-space: nowrap;
}

.product-card__action {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}
