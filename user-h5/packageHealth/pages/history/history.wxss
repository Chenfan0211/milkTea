.history-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(
    180deg,
    var(--health-gradient-top) 0%,
    var(--health-gradient-mid) 30%,
    var(--page-bg-neutral) 52%,
    var(--page-bg-neutral) 100%
  );
}

.history-scroll {
  flex: 1;
  min-height: 0;
}

.history-content {
  padding: 24rpx 32rpx 48rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.history-item + .history-item {
  margin-top: 20rpx;
}

.history-item__main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.history-item__head {
  display: flex;
  align-items: center;
}

.history-item__profile {
  margin-right: 12rpx;
  padding: 0 12rpx;
  color: var(--brand-dark);
  font-size: var(--font-caption);
  line-height: 36rpx;
  background: var(--brand-soft);
  border-radius: var(--radius-xs);
}

.history-item__physique {
  flex: 1;
  min-width: 0;
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.history-item__time {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.history-item__action {
  flex: none;
  margin-left: 16rpx;
  padding: 0 24rpx;
  color: var(--brand-green);
  font-size: var(--font-sm);
  line-height: 60rpx;
  background: var(--brand-soft);
  border-radius: var(--radius-pill);
}

.history-loading {
  padding: 80rpx 0;
  color: var(--text-muted);
  font-size: var(--font-sm);
  text-align: center;
}
