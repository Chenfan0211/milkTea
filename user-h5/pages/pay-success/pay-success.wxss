.pay-success-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg-neutral);
}

.pay-success-scroll {
  flex: 1;
  min-height: 0;
}

.pay-success__inner {
  padding: 20rpx var(--page-gutter) 0;
}

.result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx 32rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
}

.result-card__icon {
  width: 96rpx;
  height: 96rpx;
}

.result-card__title {
  margin-top: 24rpx;
  color: var(--brand-green);
  font-size: var(--font-xl);
  font-weight: 600;
}

.result-card__note {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: var(--font-base);
}

.result-card__info {
  width: 100%;
  margin-top: 32rpx;
  border-top: 1rpx solid var(--line-color);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 8rpx;
}

.info-row__label {
  color: var(--text-secondary);
  font-size: var(--font-base);
}

.info-row__value-wrap {
  display: flex;
  align-items: center;
}

.info-row__value {
  color: var(--text-main);
  font-size: var(--font-base);
}

.info-row__copy {
  width: 30rpx;
  height: 30rpx;
  margin-left: 8rpx;
}

.info-row__amount {
  color: var(--price-red);
  font-size: var(--font-xl);
  font-weight: 600;
}

.result-actions {
  margin-top: 32rpx;
}

.result-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  font-size: var(--font-base);
  font-weight: 600;
  border-radius: var(--radius-pill);
}

.result-action--primary {
  color: #ffffff;
  background: var(--brand-green);
}

.result-action--secondary {
  margin-top: 20rpx;
  color: var(--text-main);
  border: 2rpx solid var(--line-color);
}

.pay-success__safe {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
