.profile-scroll {
  height: 100vh;
  background: var(--page-bg);
}

.profile-page {
  min-height: 100vh;
  padding-bottom: 0;
  background: var(--page-bg);
}

.profile-hero {
  display: block;
  width: 750rpx;
  height: 437rpx;
  overflow: hidden;
}

.profile-content {
  position: relative;
  z-index: 1;
  margin-top: -127rpx;
  padding-bottom: 20rpx;
  background: transparent;
}

/* 已登录未绑手机号：常驻引导条 */
.bind-phone-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 20rpx 0;
  padding: 20rpx 24rpx;
  background: var(--brand-soft);
  border-radius: var(--radius-md);
}

.bind-phone-bar__icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.bind-phone-bar__text {
  flex: 1;
  min-width: 0;
  color: var(--text-main);
  font-size: var(--font-sm);
  line-height: 36rpx;
}

.bind-phone-bar__arrow {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.profile-card {
  margin-right: 20rpx;
  margin-left: 20rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(49, 73, 28, 0.06);
}

.user-card {
  padding: 32rpx 40rpx 32rpx;
}

.user-card__main {
  display: flex;
  align-items: center;
}

.user-card__avatar {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.user-card__identity {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  margin-left: 24rpx;
}

.user-card__name {
  color: var(--text-main);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 54rpx;
}

.user-card__badges {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.user-card__vip {
  padding: 4rpx 20rpx;
  color: #FFFFFF;
  font-size: var(--font-sm);
  line-height: 32rpx;
  background: var(--brand-green);
  border-radius: 16rpx;
}

.user-card__role-badge {
  margin-left: 8rpx;
  padding: 4rpx 16rpx;
  color: var(--tag-light-text);
  font-size: var(--font-sm);
  line-height: 32rpx;
  background: var(--tag-light-bg);
  border: 1rpx solid var(--brand-green);
  border-radius: 16rpx;
}

.user-card__code {
  width: 78rpx;
  height: 78rpx;
}









.progress {
  position: relative;
  margin-top: 40rpx;
  padding: 0 0 32rpx;
}

.progress__labels {
  position: absolute;
  top: -33rpx;
  right: 0;
  left: 0;
  display: flex;
  justify-content: space-between;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.progress__track {
  height: 12rpx;
  overflow: hidden;
  background: var(--line-color);
  border-radius: 8rpx;
}

.progress__value {
  height: 100%;
  min-width: 12rpx;
  background: var(--brand-green);
  border-radius: 8rpx;
}

.progress__count {
  position: absolute;
  right: 0;
  bottom: 0;
  color: var(--brand-green);
  font-size: 24rpx;
}

.pending-notice {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--brand-tint);
  border-radius: var(--radius-md);
}

.pending-notice__icon {
  flex: none;
  width: 36rpx;
  height: 36rpx;
}

.pending-notice__text {
  margin-left: 12rpx;
  color: var(--brand-green);
  font-size: var(--font-sm);
}

.role-entry {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 24rpx;
}

.role-entry__icon {
  flex: none;
  width: 54rpx;
  height: 54rpx;
}

.role-entry__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 20rpx;
}

.role-entry__title {
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.role-entry__desc {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 36rpx;
}

.role-entry__arrow {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-left: 12rpx;
}

.stats {
  display: flex;
  height: 132rpx;
  margin-top: 20rpx;
  padding: 16rpx 0;
}

.stats__item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stats__item + .stats__item::before {
  position: absolute;
  top: 12rpx;
  bottom: 12rpx;
  left: 0;
  width: 1rpx;
  background: var(--line-color);
  content: "";
}

.stats__value {
  color: var(--brand-green);
  font-size: 34rpx;
  line-height: 44rpx;
}

.stats__label {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.promo-banner {
  display: block;
  width: 710rpx;
  margin: 20rpx;
  border-radius: 16rpx;
}

.function-grid {
  display: flex;
  flex-wrap: wrap;
}

.function-item {
  display: flex;
  flex: 0 0 25%;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.function-item__icon {
  width: 54rpx;
  height: 54rpx;
}

.function-item--role {
  opacity: 1;
}

.function-item__label {
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.gift-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.gift-head__title {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.gift-head__more {
  display: flex;
  align-items: center;
  color: var(--text-muted);
  font-size: var(--font-sm);
}

.gift-head__more-icon {
  width: 26rpx;
  height: 26rpx;
  margin-left: 4rpx;
}

.gift-list {
  display: flex;
  flex-wrap: wrap;
}

.gift-card-item {
  display: flex;
  flex-direction: column;
  width: calc((100% - 20rpx) / 2);
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.gift-card-item:nth-child(2n) {
  margin-right: 0;
}

.gift-card-item__image {
  display: block;
  width: 100%;
  height: 180rpx;
}

.gift-card-item__name {
  display: block;
  padding: 12rpx;
  color: var(--text-main);
  font-size: var(--font-sm);
  font-weight: 600;
  text-align: center;
}

.gift-card-empty {
  padding: 32rpx 0;
  color: var(--text-muted);
  font-size: var(--font-sm);
  text-align: center;
}
.user-card__phone {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.user-card__phone--bind {
  color: var(--brand-green);
}


/* 静默登录失败提示条：非阻塞，点击可重试 */
.profile-login-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 16rpx 20rpx 0;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--tag-hot-bg);
}

.profile-login-tip__text {
  font-size: 24rpx;
  color: var(--price-red);
}

/* 未登录登录引导卡：替代隐藏掉的个人数据区 */
.login-invite {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
  padding: 40rpx 32rpx;
}

.login-invite__title {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
  line-height: 48rpx;
}

.login-invite__desc {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 40rpx;
  text-align: center;
}

.login-invite__action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  margin-top: 32rpx;
  color: var(--card-bg);
  font-size: var(--font-md);
  font-weight: 600;
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}