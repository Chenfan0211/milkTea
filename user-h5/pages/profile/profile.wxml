<scroll-view class="profile-scroll" scroll-y enhanced="{{false}}">
  <view class="profile-page">
    <image class="profile-hero" src="/assets/images/3x/profile-hero.jpg" mode="aspectFill" aria-label="五零时光新中式养生茶饮" />

    <!-- 静默登录失败提示：非阻塞，可点击重试，避免用户「不知道登没登上」 -->
    <view
      wx:if="{{loginFailed}}"
      class="profile-login-tip"
      bindtap="handleRetryLogin"
      aria-role="button"
      aria-label="登录失败，点击重试"
    >
      <text class="profile-login-tip__text">登录失败，点击重试</text>
    </view>

    <view class="profile-content">
      <view class="profile-card user-card">
        <view class="user-card__main">
          <image class="user-card__avatar" src="{{userProfile.avatar || defaultAvatar}}" mode="aspectFill" binderror="handleAvatarError" bindtap="openProfileData" aria-role="button" aria-label="编辑个人资料" />
          <view class="user-card__identity" bindtap="openProfileData" aria-role="button" aria-label="查看和编辑个人资料">
            <text class="user-card__name">{{authLabel === '未登录' ? '点击登录' : userProfile.nickname}}</text>
            <text wx:if="{{authStateLevel === 'full' && phoneMasked}}" class="user-card__phone">{{phoneMasked}}</text>
            <text wx:elif="{{authStateLevel === 'authorized'}}" class="user-card__phone user-card__phone--bind" catchtap="handleBindPhone">绑定手机号</text>
            <text wx:elif="{{authStateLevel === 'anonymous'}}" class="user-card__phone">登录后可下单与领券</text>
            <view class="user-card__badges">
              <text class="user-card__vip">{{userProfile.vipLevel}}</text>
              <text wx:if="{{businessRole}}" class="user-card__role-badge">{{businessRole.label}}</text>
          </view>
        </view>
        <image
          class="user-card__code"
          src="/assets/icons/lucide/qr-code.svg"
          mode="aspectFit"
          data-label="会员码"
          bindtap="showUnavailable"
          aria-role="button"
          aria-label="会员码"
        />
      </view>

      <!-- 已登录未绑手机号：常驻引导条，点击复用 handleBindPhone（不新增接口） -->
      <view
        wx:if="{{authStateLevel === 'authorized'}}"
        class="bind-phone-bar"
        bindtap="handleBindPhone"
        aria-role="button"
        aria-label="绑定手机号以便下单与领取优惠券"
      >
        <image class="bind-phone-bar__icon" src="/assets/icons/lucide/phone.svg" mode="aspectFit" />
        <text class="bind-phone-bar__text">绑定手机号，下单与领券更顺畅</text>
        <image class="bind-phone-bar__arrow" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" />
      </view>

      <view class="progress" bindtap="openMemberRights" aria-role="button" aria-label="查看会员权益">
        <view class="progress__labels">
          <text>{{vipLevel}}</text>
          <text>{{nextLevel}}</text>
        </view>
        <view class="progress__track">
          <view class="progress__value" style="width: {{progressPercent}}%;"></view>
        </view>
        <text class="progress__count">{{progressCurrent}}/{{progressTarget}}</text>
      </view>
    </view>

    <view class="profile-card stats">
      <view
        wx:for="{{stats}}"
        wx:key="id"
        class="stats__item"
        data-id="{{item.id}}"
        data-label="{{item.label}}"
        bindtap="handleProfileAction"
        aria-role="button"
        aria-label="{{item.label}}"
      >
        <text class="stats__value">{{item.value}}</text>
        <text class="stats__label">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{pendingRoleCount > 0}}" class="pending-notice">
      <image class="pending-notice__icon" src="/assets/icons/lucide/circle-check-big.svg" mode="aspectFit" />
      <text class="pending-notice__text">您有 {{pendingRoleCount}} 个角色申请审核中</text>
    </view>

    <view class="profile-card role-entry" bindtap="openRoleCenter" aria-role="button" aria-label="进入角色中心">
      <image class="role-entry__icon" src="/assets/icons/lucide/users-brand.svg" mode="aspectFit" />
      <view class="role-entry__body">
        <text class="role-entry__title">角色中心</text>
        <text class="role-entry__desc">{{businessRole ? '切换当前经营角色' : '尚未开通经营角色'}}</text>
      </view>
      <image class="role-entry__arrow" src="/assets/icons/lucide/chevron-right-brand.svg" mode="aspectFit" />
    </view>

    <image class="promo-banner" src="/assets/images/3x/profile-banner.jpg" mode="widthFix" bindtap="openMenu" aria-label="抹茶轻茉莉新品" />

    <section-card title="我的功能">
      <view class="function-grid">
        <view
          wx:for="{{profileFunctions}}"
          wx:key="id"
          class="function-item"
          data-id="{{item.id}}"
          data-label="{{item.label}}"
          bindtap="handleProfileAction"
        >
          <image class="function-item__icon" src="{{item.icon}}" mode="aspectFit" />
          <text class="function-item__label">{{item.label}}</text>
        </view>
        <view
          wx:for="{{roleFunctions}}"
          wx:key="id"
          class="function-item function-item--role"
          data-action="{{item.actionId}}"
          bindtap="openRoleFunction"
          aria-role="button"
          aria-label="{{item.label}}"
        >
          <image class="function-item__icon" src="{{item.icon}}" mode="aspectFit" />
          <text class="function-item__label">{{item.label}}</text>
        </view>
      </view>
    </section-card>

    <section-card>
      <view class="gift-head">
        <text class="gift-head__title">礼品卡</text>
        <view class="gift-head__more" bindtap="openGiftCards" aria-role="button" aria-label="查看更多礼品卡">
          <text>查看更多</text>
          <image class="gift-head__more-icon" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" />
        </view>
      </view>
      <view wx:if="{{giftCards.length}}" class="gift-list">
        <view
          wx:for="{{giftCards}}"
          wx:key="id"
          class="gift-card-item"
          data-id="{{item.id}}"
          bindtap="openGiftCards"
          aria-role="button"
          aria-label="{{item.name}}礼品卡"
        >
          <image class="gift-card-item__image" src="{{item.image}}" mode="aspectFill" />
          <text class="gift-card-item__name ellipsis">{{item.name}}</text>
        </view>
      </view>
      <view wx:else class="gift-card-empty">暂无礼品卡</view>
    </section-card>
  </view>

  <view class="tabbar-safe-space"></view>
</view>
</scroll-view>



