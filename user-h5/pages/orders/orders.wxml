<view class="orders-page">
  <navigation-bar ext-class="orders-nav" title="我的订单" background="#FFFFFF" color="#2F302D">
    <view slot="left" class="invoice-entry" bindtap="showInvoice" aria-role="button" aria-label="开发票">
      <image class="invoice-entry__icon" src="/assets/icons/lucide/receipt.svg" mode="aspectFit" />
      <text class="invoice-entry__label">开发票</text>
    </view>
  </navigation-bar>

  <view class="orders-filter">
    <view class="orders-time-tabs">
      <view
        wx:for="{{timeTabs}}"
        wx:key="id"
        class="orders-time-tab {{activeTimeGroup === item.id ? 'is-active' : ''}}"
        data-group="{{item.id}}"
        bindtap="selectTimeGroup"
        aria-role="button"
        aria-label="{{item.label}}"
      >{{item.label}}</view>
    </view>

    <scroll-view class="orders-categories" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="orders-categories__inner">
        <view
          wx:for="{{orderCategories}}"
          wx:key="id"
          class="orders-category {{activeCategory === item.id ? 'is-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectCategory"
          aria-role="button"
          aria-label="{{item.label}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <scroll-view class="orders-list" scroll-y show-scrollbar="{{false}}">
    <view class="orders-list__inner">
      <view
        wx:for="{{filteredOrders}}"
        wx:key="id"
        class="order-card order-card--{{item.category}} {{item.isCanceled ? 'is-canceled' : ''}}"
        data-id="{{item.id}}"
        bindtap="openOrderDetail"
        aria-role="button"
        aria-label="{{item.title}}订单"
      >
        <view wx:if="{{item.category === 'store' || item.category === 'purchase'}}" class="order-card__store-head">
          <text class="order-card__type">{{item.type}}</text>
          <text class="order-card__store ellipsis">{{item.storeName}}</text>
          <view class="order-card__status-wrap {{item.isCanceled ? 'is-canceled' : ''}}">
            <text class="order-card__status">{{item.statusText}}</text>
            <text wx:if="{{item.isPendingPayment}}" class="order-card__countdown">{{item.countdownText}}</text>
          </view>
        </view>

        <view wx:else class="order-card__head">
          <text class="order-card__title ellipsis">{{item.title}}</text>
          <view class="order-card__status-wrap {{item.isCanceled ? 'is-canceled' : ''}}">
            <text class="order-card__status">{{item.statusText}}</text>
            <text wx:if="{{item.isPendingPayment}}" class="order-card__countdown">{{item.countdownText}}</text>
          </view>
        </view>

        <view wx:if="{{item.category === 'store' || item.category === 'purchase'}}" class="store-order">
          <view wx:if="{{item.previewItems.length === 1}}" class="store-order__single">
            <image class="store-order__single-image" src="{{item.firstItem.image}}" mode="aspectFit" />
            <view class="store-order__single-copy">
              <text class="store-order__single-name ellipsis">{{item.firstItem.name}}</text>
              <text class="store-order__single-spec ellipsis">{{item.firstItem.spec}}</text>
            </view>
          </view>
          <view wx:else class="store-order__products">
            <view wx:for="{{item.previewItems}}" wx:key="id" wx:for-item="product" class="store-order__product">
              <image class="store-order__image" src="{{product.image}}" mode="aspectFit" />
              <text class="store-order__name ellipsis">{{product.name}}</text>
            </view>
          </view>
          <view class="order-card__amount">
            <text class="order-card__price">¥{{item.amountText}}</text>
            <text class="order-card__count">共{{item.count}}件</text>
          </view>
        </view>

        <view wx:else class="cover-order">
          <image class="cover-order__image" src="{{item.coverImage}}" mode="aspectFill" />
          <view class="order-card__amount">
            <text class="order-card__price">¥{{item.amountText}}</text>
          </view>
        </view>

        <view class="order-card__meta-list">
          <text class="order-card__meta">订单号 {{item.orderInfo.orderNo}}</text>
          <text wx:if="{{item.payTime}}" class="order-card__meta">支付时间 {{item.payTime}}</text>
        </view>

        <view wx:if="{{item.isPendingPayment}}" class="order-card__actions">
          <view class="order-card__action order-card__action--secondary" data-id="{{item.id}}" catchtap="cancelOrder" aria-role="button" aria-label="取消订单">取消订单</view>
          <view class="order-card__action order-card__action--primary" data-id="{{item.id}}" catchtap="handlePay" aria-role="button" aria-label="立即支付">立即支付</view>
        </view>
        <view wx:if="{{item.isPaidCancellable}}" class="order-card__actions">
          <view class="order-card__action order-card__action--secondary" data-id="{{item.id}}" catchtap="cancelPaidOrder" aria-role="button" aria-label="取消订单">取消订单</view>
        </view>
      </view>

      <view wx:if="{{!filteredOrders.length}}" class="orders-empty">
        <empty-state icon="/assets/icons/lucide/orders-active.svg" title="暂无订单" description="该分类下还没有订单记录" />
      </view>
      <view wx:else class="orders-end">到底了，仅展示近一年订单</view>

      <view class="tabbar-safe-space"></view>
    </view>
  </scroll-view>
</view>
