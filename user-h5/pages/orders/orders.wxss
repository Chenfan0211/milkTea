.orders-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg-neutral);
}

.orders-nav .weui-navigation-bar__center {
  right: 262rpx;
  left: 262rpx;
}

.invoice-entry {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  border: 2rpx solid var(--line-color);
  border-radius: var(--radius-pill);
}

.invoice-entry__icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}

.orders-filter {
  flex: none;
  background: var(--card-bg);
}

.orders-time-tabs {
  display: flex;
  height: 96rpx;
  border-bottom: 1rpx solid var(--line-color);
}

.orders-time-tab {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: var(--font-lg);
}

.orders-time-tab.is-active {
  color: var(--brand-green);
  font-weight: 600;
}

.orders-time-tab.is-active::after {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 72rpx;
  height: 4rpx;
  background: var(--brand-green);
  border-radius: var(--radius-xs);
  content: '';
  transform: translateX(-50%);
}

.orders-categories {
  width: 100%;
  height: 92rpx;
  white-space: nowrap;
}

.orders-categories__inner {
  display: inline-flex;
  align-items: center;
  height: 92rpx;
  padding: 0 var(--page-gutter);
}

.orders-category {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: 136rpx;
  height: 56rpx;
  margin-right: 16rpx;
  padding: 0 20rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  background: var(--card-bg);
  border: 1rpx solid var(--line-color);
  border-radius: var(--radius-sm);
}

.orders-category.is-active {
  color: var(--brand-green);
  font-weight: 600;
  background: var(--brand-soft);
  border-color: var(--brand-green);
}

.orders-list {
  flex: 1;
  min-height: 0;
}

.orders-list__inner {
  padding: 20rpx var(--page-gutter) 0;
}

.order-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.order-card__head,
.order-card__store-head {
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.order-card__type {
  flex: none;
  margin-right: 12rpx;
  padding: 4rpx 12rpx;
  color: var(--brand-green);
  font-size: var(--font-sm);
  line-height: 28rpx;
  border: 2rpx solid var(--brand-green);
  border-radius: var(--radius-xs);
}

.order-card__store,
.order-card__title {
  flex: 1;
  min-width: 0;
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.order-card__status-wrap {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
  color: var(--brand-green);
}

.order-card__status {
  font-size: var(--font-sm);
  font-weight: 600;
}

.order-card__countdown {
  margin-top: 4rpx;
  font-size: var(--font-sm);
}

.order-card__status-wrap.is-canceled,
.order-card.is-canceled .order-card__type {
  color: var(--text-muted);
  border-color: var(--text-muted);
}

.store-order,
.cover-order {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
}

.store-order__single {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.store-order__single-image {
  display: block;
  flex: none;
  width: 120rpx;
  height: 120rpx;
  background: var(--page-bg);
  border-radius: var(--radius-sm);
}

.store-order__single-copy {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.store-order__single-name,
.store-order__single-spec {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-order__single-name {
  color: var(--text-main);
  font-size: var(--font-sm);
  font-weight: 600;
}

.store-order__single-spec {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
}
.store-order__products {
  display: flex;
  flex: 1;
  min-width: 0;
}

.store-order__product {
  width: 120rpx;
  margin-right: 16rpx;
}

.store-order__image {
  display: block;
  width: 120rpx;
  height: 120rpx;
  background: var(--page-bg);
  border-radius: var(--radius-sm);
}

.store-order__name {
  display: block;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  text-align: left;
}

.cover-order__image {
  display: block;
  width: 160rpx;
  height: 104rpx;
  background: var(--page-bg);
  border-radius: var(--radius-sm);
}

.order-card__amount {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  min-width: 150rpx;
  margin-left: 16rpx;
}

.order-card__price {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
  line-height: 46rpx;
}

.order-card__count {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
}

.order-card__meta-list {
  margin-top: 16rpx;
}

.order-card__meta {
  display: block;
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
}

.order-card__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.order-card__action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  height: 48rpx;
  padding: 0 24rpx;
  font-size: var(--font-sm);
  border-radius: var(--radius-pill);
}

.order-card__action--secondary {
  margin-right: 16rpx;
  color: var(--text-main);
  background: var(--card-bg);
  border: 1rpx solid var(--line-color);
}

.order-card__action--primary {
  color: var(--card-bg);
  background: var(--brand-green);
}

.orders-empty {
  padding: 40rpx 0 0;
}

.orders-end {
  padding: 24rpx 0;
  color: var(--text-muted);
  font-size: var(--font-sm);
  text-align: center;
}
