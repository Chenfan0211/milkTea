.coupon-products-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg-neutral);
}

.coupon-products-scroll {
  flex: 1;
  min-height: 0;
}

.coupon-products-scroll__inner {
  min-height: 100%;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.coupon-products-content {
  padding: 0 var(--page-gutter);
}

.coupon-products-title {
  display: block;
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
  line-height: 1.3;
}

.coupon-product-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.coupon-product {
  width: calc((100% - 24rpx) / 3);
  margin-right: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  background: var(--card-bg);
  border: 1rpx solid var(--line-color);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}

.coupon-product:nth-child(3n) {
  margin-right: 0;
}

.coupon-product__media {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 220rpx;
  background: var(--card-bg);
}

.coupon-product__image {
  display: block;
  width: 100%;
  height: 100%;
}

.coupon-product__body {
  padding: 12rpx;
}

.coupon-product__name {
  display: block;
  color: var(--text-main);
  font-size: var(--font-base);
  line-height: 40rpx;
}

.coupon-product__size {
  display: block;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 32rpx;
}
