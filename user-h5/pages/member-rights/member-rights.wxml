<view class="member-rights-page">
  <navigation-bar title="{{navigationTitle}}" back="{{showBack}}" background="#FFFFFF" color="#2F302D" />

  <scroll-view class="member-rights-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="member-rights-content">
      <member-panel
        levels="{{levels}}"
        axis="{{axis}}"
        current-index="{{currentIndex}}"
        current-level="{{currentLevel}}"
        progress-percent="{{progressPercent}}"
        progress-label="{{progressLabel}}"
        growth="{{currentGrowth}}"
        bind:openrules="openLevelRules"
      />
      <view class="tabbar-safe-space"></view>
    </view>
  </scroll-view>
</view>