<scroll-view class="home-scroll" scroll-y enhanced="{{false}}">
  <view class="home-page">
    <view class="hero-wrap">
      <image class="home-hero" src="/assets/images/3x/home-hero.jpg" mode="widthFix" aria-label="金秋入茶限定上新" />
  </view>

  <view class="home-card">
    <view class="user-strip">
      <text wx:if="{{userProfile.nickname}}">{{userProfile.nickname}}</text>
      <text
        wx:else
        class="user-strip__login"
        bindtap="handleLoginTap"
        aria-role="button"
        aria-label="登录后可同步会员权益与订单"
      >点击登录</text>
      <view class="coupon-link" bindtap="openCoupons" aria-role="button" aria-label="查看优惠券">
        <text>优惠券{{userProfile.couponCount || 5}}张</text>
        <image class="coupon-link__arrow" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="order-modes">
      <view class="order-mode" data-mode="dinein" bindtap="selectOrderMode" aria-role="button" aria-label="选择店内堂食">
        <text class="order-mode__title">店内堂食</text>
        <text class="order-mode__description">领券下单享优惠</text>
      </view>
      <view class="order-mode" data-mode="pickup" bindtap="selectOrderMode" aria-role="button" aria-label="选择打包自取">
        <text class="order-mode__title">打包自取</text>
        <text class="order-mode__description">到店自取免排队</text>
      </view>
    </view>

    <view class="home-card__divider"></view>

    <view class="shortcut-grid">
      <view
        wx:for="{{homeShortcuts}}"
        wx:key="id"
        class="shortcut-item"
        data-id="{{item.id}}"
        data-label="{{item.label}}"
        aria-role="button"
        aria-label="{{item.label}}"
        bindtap="handleShortcut"
      >
        <image class="shortcut-item__icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="shortcut-item__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view
    class="join-card"
    data-label="加盟合作"
    bindtap="openJoinApply"
    aria-role="button"
    aria-label="加入我们，新中式养生茶饮连锁品牌，点击合作"
  >
    <image class="join-card__image" src="/assets/images/3x/join-banner.jpg" mode="widthFix" />
  </view>
  <view class="tabbar-safe-space"></view>
</view>
</scroll-view>
  <!--
    登录弹层（图 1）：点击「点击登录」唤起，不再跳独立授权页。
    注意：必须由页面侧 wx:if 控制「组件本身是否渲染」。
    Skyline 渲染器下自定义组件的宿主节点即使子节点 wx:if 为 false 也会占位，
    内部 fixed 全屏层会把整页点击吃掉（表现为所有图标点了没反应）。
  -->
  <login-sheet
    wx:if="{{loginSheetVisible}}"
    brand-name="五零时光"
    bind:close="closeLoginSheet"
    bind:skip="handleLoginSkip"
    bind:success="handleLoginSuccess"
    bind:fail="handleLoginFail"
  />

