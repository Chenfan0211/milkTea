.home-scroll {
  height: 100vh;
  background: var(--brand-tint);
}

.home-page {
  min-height: 100vh;
  padding-bottom: 0;
  background: var(--brand-tint);
}

.hero-wrap {
  position: relative;
  height: 1040rpx;
}

.home-hero {
  display: block;
  width: 750rpx;
  height: 1040rpx;
}

.home-card {
  position: relative;
  z-index: 1;
  margin: -13rpx 20rpx 0;
  overflow: hidden;
  background: var(--card-bg);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}

.user-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 58rpx;
  padding: 0 62rpx;
  color: var(--text-main);
  font-size: 28rpx;
  background: var(--line-color);
}

.coupon-link {
  display: flex;
  align-items: center;
  height: 100%;
}

.coupon-link__arrow {
  width: 34rpx;
  height: 34rpx;
  margin-left: 8rpx;
}

.order-modes {
  display: flex;
  height: 188rpx;
}

.order-mode {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 20rpx;
}

.order-mode + .order-mode {
  border-left: 1rpx solid var(--line-color);
}

.order-mode__title {
  color: var(--text-main);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 58rpx;
}

.order-mode__description {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.home-card__divider {
  height: 1rpx;
  margin: 0 72rpx;
  background: var(--line-color);
}

.shortcut-grid {
  display: flex;
  align-items: center;
  height: 142rpx;
  padding: 0 8rpx;
}

.shortcut-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.shortcut-item__icon {
  width: 62rpx;
  height: 62rpx;
}

.shortcut-item__label {
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.join-card {
  position: relative;
  width: 710rpx;
  height: 200rpx;
  margin: 6rpx 20rpx 0;
  overflow: hidden;
  border-radius: 8rpx;
}

.join-card__image {
  display: block;
  width: 710rpx;
  height: 200rpx;
}
