.withdraw-detail-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg-neutral);
}

.withdraw-detail-scroll {
  flex: 1;
  min-height: 0;
}

.withdraw-detail-empty {
  padding: 20rpx;
}

.withdraw-detail-content {
  padding: 24rpx var(--page-gutter) calc(40rpx + env(safe-area-inset-bottom));
}

/* ① 状态头卡 */
.detail-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
  background: var(--brand-green);
  border-radius: var(--radius-lg);
}

.detail-hero--pending {
  background: var(--queue-warning);
}

.detail-hero--failed {
  background: var(--accent-orange);
}

.detail-hero__status {
  color: var(--card-bg);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 40rpx;
}

.detail-hero__amount {
  margin-top: 8rpx;
  color: var(--card-bg);
  font-size: var(--font-display);
  font-weight: 600;
  line-height: 72rpx;
}

.detail-hero__note {
  margin-top: 12rpx;
  color: var(--card-bg);
  font-size: var(--font-sm);
  line-height: 36rpx;
  text-align: center;
  opacity: 0.86;
}

/* 失败原因提示 */
.detail-alert {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--tag-gold-bg);
  border-radius: var(--radius-lg);
}

.detail-alert__icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.detail-alert__text {
  flex: 1;
  min-width: 0;
  color: var(--accent-orange);
  font-size: var(--font-sm);
  line-height: 40rpx;
}

/* 卡片 */
.detail-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.detail-card__head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.detail-card__icon {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.detail-card__title {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
  line-height: 40rpx;
}

/* ② 状态流转时间线 */
.detail-timeline {
  margin-top: 16rpx;
}

.timeline-item {
  display: flex;
}

.timeline-item__rail {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  width: 36rpx;
  padding-top: 8rpx;
}

.timeline-item__dot {
  flex: none;
  width: 24rpx;
  height: 24rpx;
}

.timeline-item__line {
  flex: 1;
  width: 2rpx;
  margin: 8rpx 0;
  background: var(--line-color);
}

.timeline-item--done .timeline-item__line,
.timeline-item--active .timeline-item__line {
  background: var(--brand-green);
}

.timeline-item__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 0 0 32rpx 16rpx;
}

.timeline-item:last-child .timeline-item__body {
  padding-bottom: 0;
}

.timeline-item__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.timeline-item__title {
  color: var(--text-muted);
  font-size: var(--font-base);
  font-weight: 600;
  line-height: 36rpx;
}

.timeline-item--done .timeline-item__title {
  color: var(--text-main);
}

.timeline-item--active .timeline-item__title {
  color: var(--brand-green);
}

.timeline-item__time {
  flex: none;
  margin-left: 16rpx;
  color: var(--text-muted);
  font-size: var(--font-caption);
}

.timeline-item--done .timeline-item__time,
.timeline-item--active .timeline-item__time {
  color: var(--text-secondary);
}

.timeline-item__desc {
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 36rpx;
}

.timeline-item--done .timeline-item__desc,
.timeline-item--active .timeline-item__desc {
  color: var(--text-secondary);
}

/* ③ 提现信息 */
.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-color);
}

.detail-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.detail-row__label {
  flex: none;
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.detail-row__value {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  text-align: right;
  word-break: break-all;
}

.detail-row__value--strong {
  color: var(--brand-green);
  font-weight: 600;
}

.detail-row__copy {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  margin-left: 24rpx;
}

.detail-row__copy-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
}

.withdraw-detail-safe {
  height: 20rpx;
}