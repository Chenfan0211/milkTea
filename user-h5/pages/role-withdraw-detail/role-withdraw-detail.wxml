<view class="withdraw-detail-page">
  <navigation-bar title="提现详情" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <scroll-view class="withdraw-detail-scroll" scroll-y show-scrollbar="{{false}}">
    <view wx:if="{{!ready}}" class="withdraw-detail-empty">
      <empty-state title="记录不存在" description="该提现记录已失效或不属于当前角色" icon="/assets/icons/lucide/file-search-brand.svg" />
    </view>

    <view wx:else class="withdraw-detail-content">
      <view class="detail-hero detail-hero--{{record.status}}">
        <text class="detail-hero__status">{{record.statusLabel}}</text>
        <text class="detail-hero__amount">{{record.amount}}</text>
        <text class="detail-hero__note">{{record.statusNote}}</text>
      </view>

      <view wx:if="{{record.failReason}}" class="detail-alert">
        <image class="detail-alert__icon" src="/assets/icons/lucide/circle-alert-warning.svg" mode="aspectFit" />
        <text class="detail-alert__text">{{record.failReason}}</text>
      </view>

      <view class="detail-card">
        <view class="detail-card__head">
          <image class="detail-card__icon" src="/assets/icons/lucide/hourglass-brand.svg" mode="aspectFit" />
          <text class="detail-card__title">状态流转</text>
        </view>

        <view class="detail-timeline">
          <view wx:for="{{record.timeline}}" wx:key="id" class="timeline-item timeline-item--{{item.state}}">
            <view class="timeline-item__rail">
              <image
                class="timeline-item__dot"
                src="{{item.state === 'todo' ? '/assets/icons/lucide/circle-dot-muted.svg' : '/assets/icons/lucide/circle-dot-brand.svg'}}"
                mode="aspectFit"
              />
              <view wx:if="{{index !== record.timeline.length - 1}}" class="timeline-item__line"></view>
            </view>
            <view class="timeline-item__body">
              <view class="timeline-item__head">
                <text class="timeline-item__title">{{item.title}}</text>
                <text class="timeline-item__time">{{item.time || '待处理'}}</text>
              </view>
              <text class="timeline-item__desc">{{item.description}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="detail-card">
        <view class="detail-card__head">
          <image class="detail-card__icon" src="/assets/icons/lucide/receipt-brand.svg" mode="aspectFit" />
          <text class="detail-card__title">提现信息</text>
        </view>

        <view class="detail-row">
          <text class="detail-row__label">提现单号</text>
          <view
            class="detail-row__copy"
            bindtap="copyOrderNo"
            aria-role="button"
            aria-label="复制提现单号"
          >
            <text class="detail-row__value">{{record.orderNo}}</text>
            <image class="detail-row__copy-icon" src="/assets/icons/lucide/copy.svg" mode="aspectFit" />
          </view>
        </view>

        <view class="detail-row">
          <text class="detail-row__label">提现金额</text>
          <text class="detail-row__value">{{record.amount}}</text>
        </view>

        <view class="detail-row">
          <text class="detail-row__label">手续费</text>
          <text class="detail-row__value">{{record.feeText}}</text>
        </view>

        <view class="detail-row">
          <text class="detail-row__label">实际到账</text>
          <text class="detail-row__value detail-row__value--strong">{{record.arrivalText}}</text>
        </view>

        <view class="detail-row">
          <text class="detail-row__label">收款方式</text>
          <text class="detail-row__value">{{record.channel}}</text>
        </view>

        <view class="detail-row">
          <text class="detail-row__label">申请时间</text>
          <text class="detail-row__value">{{record.time}}</text>
        </view>
      </view>

      <view class="withdraw-detail-safe"></view>
    </view>
  </scroll-view>
</view>