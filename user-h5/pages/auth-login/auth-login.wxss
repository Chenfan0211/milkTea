.auth-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--card-bg);
}

.auth-scroll {
  flex: 1;
  min-height: 0;
}

.auth-content {
  display: flex;
  flex-direction: column;
  padding: 40rpx var(--page-gutter) 40rpx;
}

/* 品牌区：绿色圆形 logo + 温馨提示 */
.auth-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 32rpx;
}

.auth-brand__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}

.auth-brand__mark-icon {
  width: 88rpx;
  height: 88rpx;
}

.auth-brand__title {
  margin-top: 24rpx;
  color: var(--text-main);
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 56rpx;
}

/* 协议正文 */
.auth-doc {
  display: flex;
  flex-direction: column;
}

.auth-doc__para {
  margin-bottom: 32rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  line-height: 52rpx;
}

/* 协议勾选区 */
.auth-consent {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
  padding: 8rpx 0;
}

.auth-consent__box {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  border: 2rpx solid var(--text-muted);
  border-radius: var(--radius-pill);
}

.auth-consent__box.is-checked {
  background: var(--brand-green);
  border-color: var(--brand-green);
}

.auth-consent__check {
  width: 26rpx;
  height: 26rpx;
}

.auth-consent__text {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 40rpx;
}

.auth-consent__link {
  color: var(--brand-green);
}

/* 底部双按钮 */
.auth-actions {
  display: flex;
  flex: none;
  padding: 20rpx var(--page-gutter) calc(32rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
}

.auth-actions__ghost {
  display: flex;
  flex: 0 0 36%;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-right: 20rpx;
  color: var(--brand-green);
  font-size: var(--font-md);
  font-weight: 600;
  border: 2rpx solid var(--brand-green);
  border-radius: var(--radius-pill);
}

/* 「同意」= 手机号授权按钮（原生 button，需清掉默认样式） */
.auth-actions__primary {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  padding: 0;
  color: var(--card-bg);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 88rpx;
  background: var(--brand-green);
  border: none;
  border-radius: var(--radius-pill);
}

.auth-actions__primary::after {
  border: none;
}

.is-disabled {
  opacity: 0.5;
}