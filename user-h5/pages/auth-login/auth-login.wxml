<view class="auth-page">
  <navigation-bar title="" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <scroll-view class="auth-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="auth-content">
      <view class="auth-brand">
        <view class="auth-brand__mark">
          <image class="auth-brand__mark-icon" src="/assets/icons/lucide/leaf-white.svg" mode="aspectFit" />
        </view>
        <text class="auth-brand__name">五零时光</text>
        <text class="auth-brand__slogan">新中式养生茶饮</text>
      </view>

      <view wx:if="{{reason}}" class="auth-reason">
        <image class="auth-reason__icon" src="/assets/icons/lucide/circle-help.svg" mode="aspectFit" />
        <text class="auth-reason__text">{{reason}}</text>
      </view>

      <view class="auth-main">
        <button
          class="auth-primary"
          open-type="getPhoneNumber"
          bindgetphonenumber="handleGetPhoneNumber"
          aria-role="button"
          aria-label="微信手机号快捷登录"
        >
          <image class="auth-primary__icon" src="/assets/icons/lucide/phone-white.svg" mode="aspectFit" />
          <text class="auth-primary__text">微信手机号快捷登录</text>
        </button>

        <view
          class="auth-toggle"
          bindtap="toggleFallback"
          aria-role="button"
          aria-label="{{fallbackVisible ? '收起其他登录方式' : '展开其他登录方式'}}"
        >
          <text>其他登录方式</text>
          <image
            class="auth-toggle__icon {{fallbackVisible ? 'is-expanded' : ''}}"
            src="/assets/icons/lucide/chevron-down.svg"
            mode="aspectFit"
          />
        </view>

        <view wx:if="{{fallbackVisible}}" class="auth-fallback">
          <view class="auth-field">
            <text class="auth-field__label">手机号</text>
            <input
              class="auth-field__input"
              type="number"
              maxlength="11"
              placeholder="请输入手机号"
              placeholder-class="auth-field__placeholder"
              value="{{phone}}"
              bindinput="handlePhoneInput"
            />
          </view>

          <view class="auth-field">
            <text class="auth-field__label">验证码</text>
            <input
              class="auth-field__input"
              type="number"
              maxlength="6"
              placeholder="请输入验证码"
              placeholder-class="auth-field__placeholder"
              value="{{code}}"
              bindinput="handleCodeInput"
            />
            <view
              class="auth-field__code {{counting ? 'is-disabled' : ''}}"
              bindtap="handleSendCode"
              aria-role="button"
              aria-label="获取验证码"
            >{{counting ? countdownText + 's' : '获取验证码'}}</view>
          </view>

          <view
            class="auth-submit {{canSubmit ? '' : 'is-disabled'}}"
            bindtap="handleSubmitCode"
            aria-role="button"
            aria-label="验证并绑定手机号"
            aria-disabled="{{!canSubmit}}"
          >验证并绑定</view>
        </view>
      </view>

      <view class="auth-foot">
        <text class="auth-agreement">
          登录即代表同意
          <text class="auth-agreement__link" data-type="agreement" bindtap="openAgreement">《用户协议》</text>
          与
          <text class="auth-agreement__link" data-type="privacy" bindtap="openAgreement">《隐私政策》</text>
        </text>
        <view class="auth-skip" bindtap="handleSkip" aria-role="button" aria-label="暂不登录">
          <text>暂不登录</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>