.withdraw-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg);
}

.withdraw-scroll {
  flex: 1;
  min-height: 0;
}

.withdraw-empty {
  padding: 20rpx;
}

.withdraw-content {
  padding: 24rpx var(--page-gutter) calc(40rpx + env(safe-area-inset-bottom));
}

/* ① 可提现余额 */
.withdraw-hero {
  padding: 40rpx 32rpx 32rpx;
  background: var(--brand-green);
  border-radius: var(--radius-lg);
}

.withdraw-hero__label {
  display: block;
  color: var(--card-bg);
  font-size: var(--font-sm);
  line-height: 32rpx;
  opacity: 0.82;
}

.withdraw-hero__value {
  display: block;
  margin-top: 8rpx;
  color: var(--card-bg);
  font-size: var(--font-display);
  font-weight: 600;
  line-height: 72rpx;
}

.withdraw-hero__metrics {
  display: flex;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.24);
}

.withdraw-hero__metric {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.withdraw-hero__metric-value {
  color: var(--card-bg);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 40rpx;
}

.withdraw-hero__metric-label {
  margin-top: 4rpx;
  color: var(--card-bg);
  font-size: var(--font-sm);
  line-height: 32rpx;
  opacity: 0.82;
}

/* ② 提现表单 */
.withdraw-form {
  margin-top: 20rpx;
  padding: 32rpx 24rpx 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.withdraw-form__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.withdraw-form__title {
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 40rpx;
}

.withdraw-form__hint {
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 32rpx;
}

.withdraw-form__field {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 24rpx;
  background: var(--page-bg-neutral);
  border-radius: var(--radius-md);
}

.withdraw-form__prefix {
  flex: none;
  color: var(--text-main);
  font-size: var(--font-display);
  font-weight: 600;
  line-height: 96rpx;
}

.withdraw-form__input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  margin-left: 8rpx;
  color: var(--text-main);
  font-size: var(--font-display);
  font-weight: 600;
}

.withdraw-form__placeholder {
  color: var(--text-muted);
  font-size: var(--font-md);
  font-weight: 400;
}

.withdraw-form__all {
  flex: none;
  margin-left: 16rpx;
  padding-left: 16rpx;
  color: var(--brand-green);
  font-size: var(--font-base);
  line-height: 40rpx;
  border-left: 1rpx solid var(--line-color);
}

.withdraw-form__summary {
  display: flex;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line-color);
}

.withdraw-form__summary-item {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.withdraw-form__summary-label {
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 32rpx;
}

.withdraw-form__summary-value {
  margin-top: 4rpx;
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 40rpx;
}

.withdraw-form__submit {
  height: 80rpx;
  margin-top: 32rpx;
  color: var(--card-bg);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 80rpx;
  text-align: center;
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}

.withdraw-form__submit.is-disabled {
  color: var(--text-muted);
  background: var(--line-color);
}

/* ③ 规则 / 记录入口 */
.withdraw-links {
  margin-top: 20rpx;
  padding: 0 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.withdraw-link {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-color);
}

.withdraw-link:last-child {
  border-bottom: none;
}

.withdraw-link__icon {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.withdraw-link__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.withdraw-link__title {
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 40rpx;
}

.withdraw-link__desc {
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 32rpx;
}

.withdraw-link__arrow {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
}