.signin-rules-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--card-bg);
}

.signin-rules-scroll {
  flex: 1;
  min-height: 0;
}

.signin-rules-content {
  padding: 24rpx var(--page-gutter) calc(40rpx + env(safe-area-inset-bottom));
}

.signin-rules-content__title,
.signin-rules-content__line {
  display: block;
  color: var(--text-main);
  font-size: var(--font-md);
  line-height: 44rpx;
}
