.menu-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--card-bg);
}

.store-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 24rpx;
  background: var(--card-bg);
}

.store-row {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 520rpx;
}

.store-row__star-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 4rpx;
}

.store-row__star {
  width: 30rpx;
  height: 30rpx;
}

.store-row__content {
  min-width: 0;
}

.store-row__title-line {
  display: flex;
  align-items: center;
}

.store-row__name {
  max-width: 430rpx;
  color: var(--text-main);
  font-size: 38rpx;
  font-weight: 600;
}

.store-row__arrow {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
}

.store-row__distance {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-base);
  line-height: 34rpx;
  white-space: nowrap;
}

.store-row__distance-icon {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.store-row__queue {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  color: var(--text-main);
}

.store-row__queue-icon {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
}

.store-row__queue-text {
  font-size: var(--font-base);
  line-height: 34rpx;
}

.mode-switch {
  display: flex;
  flex: none;
  width: 174rpx;
  height: 56rpx;
  padding: 4rpx;
  background: var(--page-bg-neutral);
  border-radius: 24rpx;
}

.mode-switch__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 24rpx;
  border-radius: 24rpx;
}

.mode-switch__item.is-active {
  color: #ffffff;
  background: var(--brand-green);
}

.picker-store__queue-icon {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.queue-status--safe {
  color: var(--brand-green);
}

.queue-status--warning {
  color: var(--queue-warning);
}

.queue-status--danger {
  color: var(--price-red);
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  padding: 0 24rpx;
  background: var(--card-bg);
}

.coupon-row__text {
  padding: 0 9rpx;
  color: var(--brand-green);
  font-size: 20rpx;
  line-height: 28rpx;
  border: 2rpx solid var(--brand-green);
  border-radius: 4rpx;
}

.coupon-row__action {
  display: flex;
  align-items: center;
  color: var(--text-muted);
  font-size: 24rpx;
}

.coupon-row__chevron {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
}

.menu-content {
  display: flex;
  flex: 1;
  min-height: 0;
}

.category-scroll {
  flex: none;
  /* 栏宽 195rpx：按参考图（1170px 宽 = 750rpx）实测 304px 换算所得 */
  width: 195rpx;
  height: 100%;
  background: var(--page-bg-neutral);
}

.category-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 项高 88rpx：参考图实测两项文字行距 137px 换算所得 */
  min-height: 88rpx;
  padding: 0 16rpx;
  color: var(--brand-green);
  /* 字号取规范档位 --font-md(28rpx)：参考图实测约 26rpx，向上归到最近 token */
  font-size: 28rpx;
  line-height: 34rpx;
}

/*
 * 分类左上角标签。
 *
 * 排版：占独立一行（非 absolute 叠字），复现参考图「标签在上、分类名在下」的两行结构。
 * 尺寸：高 29rpx / 字号 20rpx / 圆角 0 8rpx 8rpx 0（左贴边），
 *       均按参考图实测（45px 高、1170px 宽换算）取整到规范档位。
 * 底色：固定 --brand-green（用户确认）。参考图实测 #5A9134，
 *       但 design-system.md 未收录该色，按「颜色只能取 token」统一回落品牌绿。
 */
.category-item__tag {
  align-self: flex-start;
  max-width: 100%;
  margin-top: 20rpx;
  overflow: hidden;
  padding: 0 12rpx;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 29rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  background: var(--brand-green);
  border-radius: 0 8rpx 8rpx 0;
}

/*
 * 分类名。只有「标签存在」时才补 4rpx 间隙：
 * 用相邻兄弟选择器而非无条件 margin，
 * 否则无标签的分类会凭空多出 4rpx 偏移，跟有标签的对不齐。
 */
.category-item__tag + .category-item__label {
  margin-top: 4rpx;
}

.category-item.is-active {
  background: #FFFFFF;
}

.category-item.is-active .category-item__label {
  font-weight: 600;
}

.product-scroll {
  flex: 1;
  height: 100%;
  min-width: 0;
  /*
   * 底部必须预留「自定义 TabBar 高度 + 安全区」，否则滚到最后一个商品时，
   * 卡片下半部分会被固定在底部的 custom-tab-bar 盖住（信息被遮挡）。
   * TabBar 高 112rpx（见 app.wxss 的 --tabbar-height，与 custom-tab-bar/index.wxss 一致），
   * 再加 32rpx 视觉留白，避免最后一张卡片紧贴 TabBar。
   */
  padding: 0 20rpx calc(var(--tabbar-height) + 32rpx + env(safe-area-inset-bottom)) 12rpx;
  background: var(--card-bg);
}

/*
 * 购物车栏可见时，底部还有 cart-bar 叠在 TabBar 之上，
 * 需要把留白追加到「TabBar + 购物车栏」的高度，避免两个浮层同时遮挡。
 * 280rpx 为已登记豁免值（与 cart-bar 组件高度口径一致）。
 */
.product-scroll.has-cart {
  padding-bottom: calc(280rpx + var(--tabbar-height) + env(safe-area-inset-bottom));
}

.product-scroll__inner {
  padding: 0;
}

.ad-title {
  display: block;
  padding: 18rpx 0 12rpx;
  color: var(--text-secondary);
  font-size: 30rpx;
  line-height: 36rpx;
}

.ad-banner {
  display: block;
  width: 100%;
  height: 140rpx;
  border-radius: 4rpx;
}

.product-section {
  padding-top: 24rpx;
}

/* ===== 门店页（点单页无门店态）：地图 + 悬浮筛选条 + 卡片列表 ===== */
.store-page {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--store-page-mint);
}

.store-page__map {
  position: relative;
  flex: none;
  width: 100%;
  /* 地图区高度：参考图比例折算值，已登记为档位豁免值 */
  height: 640rpx;
}

.store-page__nav {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 2;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  box-sizing: content-box;
  height: var(--nav-bar-height);
  padding: 0 16rpx;
  padding-top: env(safe-area-inset-top, 0px);
}

.store-page__nav-side {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
}

.store-page__nav-favorite {
  width: auto;
}

.store-page__nav-icon {
  flex: none;
  width: 48rpx;
  height: 48rpx;
}

.store-page__nav-text {
  margin-left: 8rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
}

.store-page__nav-title {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.store-page__filter {
  position: relative;
  z-index: 2;
  display: flex;
  flex: none;
  align-items: center;
  height: 104rpx;
  margin: -24rpx 20rpx 0;
  padding: 0 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-float);
}

.store-page__city {
  display: flex;
  flex: none;
  align-items: center;
  max-width: 160rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
}

.store-page__city-arrow {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-left: 4rpx;
}

.store-page__search {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  height: 48rpx;
  margin-left: 16rpx;
  padding: 0 16rpx;
  background: var(--page-bg-neutral);
  border-radius: var(--radius-md);
}

.store-page__search-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}

.store-page__search-input {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  margin-left: 8rpx;
  color: var(--text-main);
  font-size: var(--font-base);
}

.store-page__search-placeholder {
  color: var(--text-muted);
}

.store-page__search-clear {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
}

.store-page__search-clear image {
  width: 28rpx;
  height: 28rpx;
}

.store-page__locate {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 12rpx;
  color: var(--text-main);
  background: var(--page-bg-neutral);
  border-radius: 50%;
}

.store-page__locate-icon {
  width: 32rpx;
  height: 32rpx;
}

.store-page__list {
  flex: 1;
  min-height: 0;
}

.store-page__list-inner {
  padding: 20rpx;
}
