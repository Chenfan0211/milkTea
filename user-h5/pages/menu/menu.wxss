.menu-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--card-bg);
}

.store-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 24rpx;
  background: var(--card-bg);
}

.store-row {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 520rpx;
}

.store-row__star-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 4rpx;
}

.store-row__star {
  width: 30rpx;
  height: 30rpx;
}

.store-row__content {
  min-width: 0;
}

.store-row__title-line {
  display: flex;
  align-items: center;
}

.store-row__name {
  max-width: 430rpx;
  color: var(--text-main);
  font-size: 38rpx;
  font-weight: 600;
}

.store-row__arrow {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
}

.store-row__distance {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-base);
  line-height: 34rpx;
  white-space: nowrap;
}

.store-row__distance-icon {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.store-row__queue {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  color: var(--text-main);
}

.store-row__queue-icon {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
}

.store-row__queue-text {
  font-size: var(--font-base);
  line-height: 34rpx;
}

.mode-switch {
  display: flex;
  flex: none;
  width: 174rpx;
  height: 56rpx;
  padding: 4rpx;
  background: var(--page-bg-neutral);
  border-radius: 24rpx;
}

.mode-switch__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 24rpx;
  border-radius: 24rpx;
}

.mode-switch__item.is-active {
  color: #ffffff;
  background: var(--brand-green);
}

.picker-store__queue-icon {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.queue-status--safe {
  color: var(--brand-green);
}

.queue-status--warning {
  color: var(--queue-warning);
}

.queue-status--danger {
  color: var(--price-red);
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  padding: 0 24rpx;
  background: var(--card-bg);
}

.coupon-row__text {
  padding: 0 9rpx;
  color: var(--brand-green);
  font-size: 20rpx;
  line-height: 28rpx;
  border: 2rpx solid var(--brand-green);
  border-radius: 4rpx;
}

.coupon-row__action {
  display: flex;
  align-items: center;
  color: var(--text-muted);
  font-size: 24rpx;
}

.coupon-row__chevron {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
}

.menu-content {
  display: flex;
  flex: 1;
  min-height: 0;
}

.category-scroll {
  flex: none;
  width: 182rpx;
  height: 100%;
  background: var(--page-bg-neutral);
}

.category-group {
  display: flex;
  flex-direction: column;
}

.category-group.is-active {
  background: #FFFFFF;
}

/* 分组绿色标签：最多 5 字单行完整显示（5×18rpx=90rpx + 左右 padding 18rpx = 108rpx，
   仍小于 182rpx 侧栏宽度）。按产品要求不换行、不用省略号，故不设 max-width / ellipsis；
   超长名称由后台录入侧限制（分类管理 maxlength=5），不在小程序端硬截断。 */
.category-group__label {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-width: 90rpx;
  height: 30rpx;
  margin: 14rpx 0 15rpx;
  padding: 0 9rpx;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 30rpx;
  white-space: nowrap;
  background: var(--brand-green);
  border-radius: 0 8rpx 8rpx 0;
}

.category-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 59rpx;
  padding: 0 24rpx;
  color: var(--brand-green);
  font-size: 24rpx;
  line-height: 34rpx;
}


/* 分类左上角标签：绿色角标，单行显示（可留空，空则不渲染） */
.category-item__tag {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  max-width: 96rpx;
  overflow: hidden;
  padding: 0 6rpx;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  background: var(--brand-green);
  border-radius: 0 8rpx 8rpx 0;
}

.category-item.is-active {
  background: #FFFFFF;
}

.category-item.is-active .category-item__label {
  font-weight: 600;
}


.category-group:not(:last-child) .category-item:last-child {
  margin-bottom: 24rpx;
}

.product-scroll {
  flex: 1;
  height: 100%;
  min-width: 0;
  /* 默认只为底部安全区留白；有购物车时由 has-cart 追加高度 */
  padding: 0 20rpx calc(40rpx + env(safe-area-inset-bottom)) 12rpx;
  background: var(--card-bg);
}

/* 购物车栏可见时为其预留空间，避免遮挡最后一个商品（280rpx 为已登记豁免值） */
.product-scroll.has-cart {
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

.product-scroll__inner {
  padding: 0;
}

.ad-title {
  display: block;
  padding: 18rpx 0 12rpx;
  color: var(--text-secondary);
  font-size: 30rpx;
  line-height: 36rpx;
}

.ad-banner {
  display: block;
  width: 100%;
  height: 140rpx;
  border-radius: 4rpx;
}

.product-section {
  padding-top: 24rpx;
}

/* ===== 门店页（点单页无门店态）：地图 + 悬浮筛选条 + 卡片列表 ===== */
.store-page {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--store-page-mint);
}

.store-page__map {
  position: relative;
  flex: none;
  width: 100%;
  /* 地图区高度：参考图比例折算值，已登记为档位豁免值 */
  height: 640rpx;
}

.store-page__nav {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 2;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  box-sizing: content-box;
  height: var(--nav-bar-height);
  padding: 0 16rpx;
  padding-top: env(safe-area-inset-top, 0px);
}

.store-page__nav-side {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
}

.store-page__nav-favorite {
  width: auto;
}

.store-page__nav-icon {
  flex: none;
  width: 48rpx;
  height: 48rpx;
}

.store-page__nav-text {
  margin-left: 8rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
}

.store-page__nav-title {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.store-page__filter {
  position: relative;
  z-index: 2;
  display: flex;
  flex: none;
  align-items: center;
  height: 104rpx;
  margin: -24rpx 20rpx 0;
  padding: 0 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-float);
}

.store-page__city {
  display: flex;
  flex: none;
  align-items: center;
  max-width: 160rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
}

.store-page__city-arrow {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-left: 4rpx;
}

.store-page__search {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  height: 48rpx;
  margin-left: 16rpx;
  padding: 0 16rpx;
  background: var(--page-bg-neutral);
  border-radius: var(--radius-md);
}

.store-page__search-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}

.store-page__search-input {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  margin-left: 8rpx;
  color: var(--text-main);
  font-size: var(--font-base);
}

.store-page__search-placeholder {
  color: var(--text-muted);
}

.store-page__search-clear {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
}

.store-page__search-clear image {
  width: 28rpx;
  height: 28rpx;
}

.store-page__locate {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 12rpx;
  color: var(--text-main);
  background: var(--page-bg-neutral);
  border-radius: 50%;
}

.store-page__locate-icon {
  width: 32rpx;
  height: 32rpx;
}

.store-page__list {
  flex: 1;
  min-height: 0;
}

.store-page__list-inner {
  padding: 20rpx;
}

