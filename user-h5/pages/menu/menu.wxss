.menu-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #FFFFFF;
}

.store-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 24rpx;
  background: #FFFFFF;
}

.store-row {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 520rpx;
}

.store-row__star {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}

.store-row__content {
  min-width: 0;
}

.store-row__title-line {
  display: flex;
  align-items: center;
}

.store-row__name {
  max-width: 430rpx;
  color: #252622;
  font-size: 39rpx;
  font-weight: 600;
}

.store-row__arrow {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
}

.store-row__distance {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  color: #8B8C87;
  font-size: 25rpx;
  line-height: 30rpx;
}

.store-row__distance-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
}

.mode-switch {
  display: flex;
  flex: none;
  width: 174rpx;
  height: 56rpx;
  padding: 4rpx;
  background: #F5F5F5;
  border-radius: 28rpx;
}

.mode-switch__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: #777873;
  font-size: 24rpx;
  border-radius: 24rpx;
}

.mode-switch__item.is-active {
  color: #FFFFFF;
  background: #53882C;
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
}

.coupon-row__text {
  padding: 0 8rpx;
  color: #53882C;
  font-size: 20rpx;
  line-height: 28rpx;
  border: 2rpx solid #53882C;
  border-radius: 4rpx;
}

.coupon-row__action {
  display: flex;
  align-items: center;
  color: #858681;
  font-size: 26rpx;
}

.coupon-row__chevron {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
}

.menu-tabs {
  display: flex;
  height: 96rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E8E9E4;
}

.menu-tabs__item {
  position: relative;
  display: flex;
  align-items: center;
  margin-right: 58rpx;
  color: #747570;
  font-size: 32rpx;
}

.menu-tabs__item.is-active {
  color: #2D2D2D;
  font-weight: 600;
}

.menu-tabs__item.is-active::after {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 38rpx;
  height: 4rpx;
  background: #53882C;
  border-radius: 2rpx;
  content: "";
  transform: translateX(-50%);
}

.menu-content {
  display: flex;
  flex: 1;
  min-height: 0;
}

.category-scroll {
  flex: none;
  width: 182rpx;
  height: 100%;
  background: #F5F5F5;
}

.category-group {
  display: flex;
  flex-direction: column;
}

.category-group.is-active {
  background: #FFFFFF;
}

.category-group__label {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 90rpx;
  height: 30rpx;
  margin: 14rpx 0 15rpx;
  padding: 0 9rpx;
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 30rpx;
  background: #53882C;
  border-radius: 0 8rpx 8rpx 0;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 59rpx;
  padding: 0 24rpx;
  color: #53882C;
  font-size: 26rpx;
  line-height: 34rpx;
}

.category-item.is-active {
  background: #FFFFFF;
}

.category-item.is-active .category-item__label {
  font-weight: 600;
}

.category-group:not(:last-child) .category-item:last-child {
  margin-bottom: 24rpx;
}

.product-scroll {
  flex: 1;
  height: 100%;
  min-width: 0;
  background: #FFFFFF;
}

.product-scroll__inner {
  padding: 0 20rpx calc(280rpx + env(safe-area-inset-bottom)) 12rpx;
}

.ad-title {
  display: block;
  padding: 18rpx 0 12rpx;
  color: #747570;
  font-size: 30rpx;
  line-height: 36rpx;
}

.ad-banner {
  display: block;
  width: 100%;
  height: 140rpx;
  border-radius: 4rpx;
}

.product-section {
  padding-top: 22rpx;
}