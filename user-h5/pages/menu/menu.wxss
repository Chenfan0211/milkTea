.menu-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--card-bg);
}

.store-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 24rpx;
  background: var(--card-bg);
}

.store-row {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 520rpx;
}

.store-row__star-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 4rpx;
}

.store-row__star {
  width: 30rpx;
  height: 30rpx;
}

.store-row__content {
  min-width: 0;
}

.store-row__title-line {
  display: flex;
  align-items: center;
}

.store-row__name {
  max-width: 430rpx;
  color: var(--text-main);
  font-size: 38rpx;
  font-weight: 600;
}

.store-row__arrow {
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
}

.store-row__distance {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-base);
  line-height: 34rpx;
  white-space: nowrap;
}

.store-row__distance-icon {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.store-row__queue {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  color: var(--text-main);
}

.store-row__queue-icon {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
}

.store-row__queue-text {
  font-size: var(--font-base);
  line-height: 34rpx;
}

.mode-switch {
  display: flex;
  flex: none;
  width: 174rpx;
  height: 56rpx;
  padding: 4rpx;
  background: var(--page-bg-neutral);
  border-radius: 24rpx;
}

.mode-switch__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 24rpx;
  border-radius: 24rpx;
}

.mode-switch__item.is-active {
  color: #ffffff;
  background: var(--brand-green);
}

.picker-store__queue-icon {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.queue-status--safe {
  color: var(--brand-green);
}

.queue-status--warning {
  color: var(--queue-warning);
}

.queue-status--danger {
  color: var(--price-red);
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  padding: 0 24rpx;
  background: var(--card-bg);
}

.coupon-row__text {
  padding: 0 9rpx;
  color: var(--brand-green);
  font-size: 20rpx;
  line-height: 28rpx;
  border: 2rpx solid var(--brand-green);
  border-radius: 4rpx;
}

.coupon-row__action {
  display: flex;
  align-items: center;
  color: var(--text-muted);
  font-size: 24rpx;
}

.coupon-row__chevron {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
}

.menu-tabs {
  display: flex;
  height: 96rpx;
  padding: 0 24rpx;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--line-color);
}

.menu-tabs__item {
  position: relative;
  display: flex;
  align-items: center;
  margin-right: 58rpx;
  color: var(--text-secondary);
  font-size: 30rpx;
}

.menu-tabs__item.is-active {
  color: var(--dark-fill);
  font-weight: 600;
}

.menu-tabs__item.is-active::after {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 38rpx;
  height: 4rpx;
  background: var(--brand-green);
  border-radius: 4rpx;
  content: '';
  transform: translateX(-50%);
}

.menu-content {
  display: flex;
  flex: 1;
  min-height: 0;
}

.category-scroll {
  flex: none;
  width: 182rpx;
  height: 100%;
  background: var(--page-bg-neutral);
}

.category-group {
  display: flex;
  flex-direction: column;
}

.category-group.is-active {
  background: #FFFFFF;
}

.category-group__label {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 90rpx;
  height: 30rpx;
  margin: 14rpx 0 15rpx;
  padding: 0 9rpx;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 30rpx;
  background: var(--brand-green);
  border-radius: 0 8rpx 8rpx 0;
}

.category-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 59rpx;
  padding: 0 24rpx;
  color: var(--brand-green);
  font-size: 24rpx;
  line-height: 34rpx;
}


.category-item.is-active {
  background: #FFFFFF;
}

.category-item.is-active .category-item__label {
  font-weight: 600;
}


.category-group:not(:last-child) .category-item:last-child {
  margin-bottom: 24rpx;
}

.product-scroll {
  flex: 1;
  height: 100%;
  min-width: 0;
  background: var(--card-bg);
}

.product-scroll__inner {
  padding: 0 20rpx calc(280rpx + env(safe-area-inset-bottom)) 12rpx;
}

.ad-title {
  display: block;
  padding: 18rpx 0 12rpx;
  color: var(--text-secondary);
  font-size: 30rpx;
  line-height: 36rpx;
}

.ad-banner {
  display: block;
  width: 100%;
  height: 140rpx;
  border-radius: 4rpx;
}

.product-section {
  padding-top: 24rpx;
}
.store-picker {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9000;
  background: var(--page-bg);
}

.store-picker__map {
  width: 100%;
  height: 790rpx;
}

.store-picker__nav {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 2;
}

.store-picker__title-group {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.store-picker__title {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.store-picker__favorite {
  display: flex;
  align-items: center;
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
}

.store-picker__favorite-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 4rpx;
}

.store-picker__panel {
  position: absolute;
  top: 770rpx;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--store-page-mint);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.store-picker__filter {
  display: flex;
  flex: none;
  align-items: center;
  height: 104rpx;
  padding: 0 var(--page-gutter);
}

.store-picker__city {
  display: flex;
  flex: none;
  align-items: center;
  max-width: 160rpx;
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
}

.store-picker__city-arrow {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-left: 4rpx;
}

.store-picker__search {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  height: 48rpx;
  margin-left: 16rpx;
  padding: 0 16rpx;
  background: var(--page-bg-neutral);
  border-radius: var(--radius-md);
}

.store-picker__search-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}

.store-picker__search-input {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  margin-left: 8rpx;
  color: var(--text-main);
  font-size: var(--font-base);
}

.store-picker__search-placeholder {
  color: var(--text-muted);
}

.store-picker__search-clear {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
}

.store-picker__search-clear image {
  width: 28rpx;
  height: 28rpx;
}

.store-picker__locate {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 12rpx;
  color: var(--text-main);
  background: var(--page-bg-neutral);
  border-radius: 50%;
}

.store-picker__locate-icon {
  width: 32rpx;
  height: 32rpx;
}

.store-picker__list {
  flex: 1;
  min-height: 0;
}

.store-picker__list-inner {
  padding: 24rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
}
