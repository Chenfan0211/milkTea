<view class="menu-page">
  <navigation-bar variant="solid" background="#FFFFFF" color="#2F302D" />

  <view class="store-header">
    <view class="store-row" bindtap="selectStore" aria-role="button" aria-label="切换门店">
      <view class="store-row__star-button" catchtap="handleCurrentFavorite" aria-role="button" aria-label="{{currentStore.isFavorite ? '取消收藏门店' : '收藏门店'}}">
        <image class="store-row__star" src="{{currentStore.isFavorite ? '/assets/icons/lucide/star-gold.svg' : '/assets/icons/lucide/star.svg'}}" mode="aspectFit" />
      </view>
      <view class="store-row__content">
        <view class="store-row__title-line">
          <text class="store-row__name ellipsis">{{currentStore.name}}</text>
          <image class="store-row__arrow" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" />
        </view>
        <view class="store-row__distance">
          <image class="store-row__distance-icon" src="/assets/icons/lucide/map-pin.svg" mode="aspectFit" />
          <text>{{currentStore.distanceText}}</text>
          <view wx:if="{{currentStore.queueText}}" class="store-row__queue">
            <image class="store-row__queue-icon" src="{{currentStore.queueIcon}}" mode="aspectFit" />
            <text class="store-row__queue-text">{{currentStore.queueText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="mode-switch">
      <view class="mode-switch__item {{orderMode === 'pickup' ? 'is-active' : ''}}" data-mode="pickup" bindtap="setOrderMode" aria-role="button" aria-label="切换为自提">自提</view>
      <view class="mode-switch__item {{orderMode === 'dinein' ? 'is-active' : ''}}" data-mode="dinein" bindtap="setOrderMode" aria-role="button" aria-label="切换为堂食">堂食</view>
    </view>
  </view>

  <view class="coupon-row">
    <text class="coupon-row__text">{{menuActivity.description}}</text>
    <view class="coupon-row__action" bindtap="openActivitySheet" aria-role="button" aria-label="查看活动优惠">
      <text>点击查看</text>
      <image class="coupon-row__chevron" src="/assets/icons/lucide/chevron-down.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="menu-content">
    <scroll-view class="category-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        wx:if="{{activeMenu.groups.length}}"
        wx:for="{{activeMenu.groups[0].categories}}"
        wx:for-item="category"
        wx:key="id"
        class="category-item {{selectedCategoryId === category.id ? 'is-active' : ''}}"
        data-id="{{category.id}}"
        aria-role="button"
        aria-label="{{category.label}}"
        bindtap="selectCategory"
      >
        <view wx:if="{{category.tag}}" class="category-item__tag">{{category.tag}}</view>
        <text class="category-item__label">{{category.label}}</text>
      </view>
    </scroll-view>

    <scroll-view
      class="product-scroll {{cartCount > 0 ? 'has-cart' : ''}}"
      type="list"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollIntoView}}"
    >
      <list-item id="product-top" class="product-scroll__inner">
        <text class="ad-title">新品广告标题文字</text>
        <image class="ad-banner" src="/assets/images/3x/menu-banner.jpg" mode="widthFix" data-label="新品活动" bindtap="showUnavailable" aria-role="button" aria-label="新品活动" />
      </list-item>

      <list-item wx:for="{{productRows}}" wx:key="id" id="{{item.id}}">
        <view wx:if="{{item.type === 'category'}}" class="product-section">{{item.label}}</view>
        <product-card
          wx:else
          product="{{item.product}}"
          show-divider="{{item.showDivider}}"
          bind:spec="handleSpec"
          data-label="规格选择"
        />
      </list-item>
    </scroll-view>
  </view>

  <cart-bar wx:if="{{cartCount > 0}}" count="{{cartCount}}" total="{{cartTotal}}" bind:checkout="handleCheckout" bind:cart="handleCart" />
  <cart-sheet id="cart-sheet" visible="{{cartVisible}}" items="{{cartItems}}" bind:close="closeCart" bind:change="handleCartChange" bind:checkout="handleCheckout" bind:edit="handleCartEdit" bind:info="handleCartInfo" />
  <spec-sheet
    id="spec-sheet"
    visible="{{specVisible}}"
    product="{{specProduct}}"
    mode="{{specMode}}"
    initial-quantity="{{specInitialQuantity}}"
    initial-selected-option-ids="{{specInitialSelectedOptionIds}}"
    bind:close="closeSpec"
    bind:favorite="handleSpecFavorite"
    bind:addcart="handleSpecAddCart"
    bind:buy="handleSpecBuy"
    bind:updatecart="handleCartUpdate"
  />
  <activity-sheet
    visible="{{activityVisible}}"
    activity="{{menuActivity}}"
    store="{{currentStore}}"
    bind:close="closeActivitySheet"
    bind:phone="handleActivityPhone"
    bind:view="openActivityRules"
    bind:unavailable="handleActivityUnavailable"
  />
</view>

<view wx:if="{{storePickerVisible}}" class="store-page">
  <!-- 门店页（点单页无门店态）：顶部真实地图 + 悬浮筛选条 + 门店卡片列表。
       点单页运行在 webview 渲染器下（见 menu.json），<map> 才能正常显示。 -->
  <map
    class="store-page__map"
    latitude="{{pickerAnchor.latitude}}"
    longitude="{{pickerAnchor.longitude}}"
    scale="14"
    markers="{{pickerMarkers}}"
    show-location="{{true}}"
    enable-zoom
    enable-scroll
    bindmarkertap="handlePickerMarkerTap"
  />

  <cover-view class="store-page__nav">
    <cover-view class="store-page__nav-side" bindtap="closeStorePicker">
      <cover-image class="store-page__nav-icon" src="/assets/icons/lucide/chevron-left.svg" />
    </cover-view>
    <cover-view class="store-page__nav-title">附近</cover-view>
    <cover-view class="store-page__nav-side store-page__nav-favorite" bindtap="openFavoriteStores">
      <cover-image class="store-page__nav-icon" src="/assets/icons/lucide/bookmark.svg" />
      <cover-view class="store-page__nav-text">收藏</cover-view>
    </cover-view>
  </cover-view>

  <view class="store-page__filter">
    <view class="store-page__city" bindtap="selectCity" aria-role="button" aria-label="选择城市">
      <text>{{pickerCityName}}</text>
      <image class="store-page__city-arrow" src="/assets/icons/lucide/chevron-down.svg" mode="aspectFit" />
    </view>
    <view class="store-page__search">
      <image class="store-page__search-icon" src="/assets/icons/lucide/search.svg" mode="aspectFit" />
      <input
        class="store-page__search-input"
        value="{{pickerSearchKeyword}}"
        placeholder="搜索门店"
        placeholder-class="store-page__search-placeholder"
        confirm-type="search"
        bindinput="handlePickerSearch"
      />
      <view wx:if="{{pickerSearchKeyword}}" class="store-page__search-clear" bindtap="clearPickerSearch" aria-role="button" aria-label="清空搜索">
        <image src="/assets/icons/lucide/x.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="store-page__locate" bindtap="handleLocate" aria-role="button" aria-label="重新定位">
      <image class="store-page__locate-icon" src="/assets/icons/lucide/locate-fixed.svg" mode="aspectFit" />
    </view>
  </view>

  <scroll-view class="store-page__list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="store-page__list-inner">
      <store-list-card
        wx:for="{{pickerStores}}"
        wx:key="id"
        store="{{item}}"
        selected="{{currentStore.id === item.id && pickerHasCurrentStore}}"
        bind:select="handleSelectPickerStore"
        bind:phone="handleStorePhone"
        bind:navigate="handleStoreNavigate"
      />

      <empty-state wx:if="{{!pickerStores.length}}" title="没有找到门店" description="换个关键词，或切换城市后再搜索" icon="/assets/icons/lucide/search.svg" />

      <view class="tabbar-safe-space"></view>
    </view>
  </scroll-view>
</view>

