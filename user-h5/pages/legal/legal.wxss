.legal-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg-neutral);
}

.legal-scroll {
  flex: 1;
  min-height: 0;
}

.legal-empty {
  padding: 20rpx;
}

.legal-content {
  padding: 24rpx var(--page-gutter) calc(40rpx + env(safe-area-inset-bottom));
}

/* 文档头 */
.legal-head {
  padding: 32rpx 24rpx;
  background: var(--brand-soft);
  border-radius: var(--radius-lg);
}

.legal-head__title {
  display: block;
  color: var(--text-main);
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 52rpx;
}

.legal-head__meta {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}

.legal-head__meta-item {
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 36rpx;
}

/* 引言 */
.legal-lead {
  display: block;
  margin-top: 20rpx;
  padding: 24rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 44rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

/* 章节 */
.legal-sections {
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.legal-section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-color);
}

.legal-section:last-child {
  border-bottom: none;
}

.legal-section__title {
  display: block;
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 44rpx;
}

.legal-section__clause {
  display: block;
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 44rpx;
  word-break: break-word;
}

/* 脚注 */
.legal-foot {
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.legal-foot__line {
  display: block;
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 40rpx;
}

.legal-safe {
  height: 20rpx;
}