<view class="gift-orders-page">
  <navigation-bar title="礼品卡订单" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <view class="gift-orders-toolbar">
    <view class="gift-orders-search">
      <image class="gift-orders-search__icon" src="/assets/icons/lucide/search.svg" mode="aspectFit" />
      <input
        class="gift-orders-search__input"
        value="{{searchKeyword}}"
        placeholder="搜索礼品卡名称或订单号"
        placeholder-class="gift-orders-search__placeholder"
        confirm-type="search"
        bindinput="handleSearchInput"
        aria-label="搜索礼品卡名称或订单号"
      />
      <view
        wx:if="{{searchKeyword}}"
        class="gift-orders-search__clear"
        bindtap="clearSearch"
        aria-role="button"
        aria-label="清空搜索"
      >
        <image class="gift-orders-search__clear-icon" src="/assets/icons/lucide/x.svg" mode="aspectFit" />
      </view>
    </view>

    <scroll-view class="gift-orders-status" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="gift-orders-status__inner">
        <view
          wx:for="{{statusTabs}}"
          wx:key="id"
          class="gift-orders-status__item {{activeStatus === item.id ? 'is-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectStatus"
          aria-role="button"
          aria-label="{{item.label}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <scroll-view class="gift-orders-list" scroll-y show-scrollbar="{{false}}">
    <view class="gift-orders-list__inner">
      <view
        wx:for="{{filteredOrders}}"
        wx:key="id"
        class="gift-order-card {{item.isCanceled ? 'is-canceled' : ''}}"
        data-id="{{item.id}}"
        bindtap="openOrderDetail"
        aria-role="button"
        aria-label="{{item.title}}订单"
      >
        <view class="gift-order-card__head">
          <text class="gift-order-card__title ellipsis">{{item.title}}</text>
          <view class="gift-order-card__status-wrap">
            <text wx:if="{{item.isPendingPayment}}" class="gift-order-card__countdown">剩余支付 {{item.countdownText}}</text>
            <text class="gift-order-card__status">{{item.statusText}}</text>
          </view>
        </view>

        <view class="gift-order-card__main">
          <image class="gift-order-card__image" src="{{item.coverImage}}" mode="aspectFill" />
          <view class="gift-order-card__amount">
            <text class="gift-order-card__price">{{item.isExchange ? item.amountText + ' 时光币' : '¥' + item.amountText}}</text>
          </view>
        </view>

        <view class="gift-order-card__info">
          <text class="gift-order-card__meta">订单号 {{item.orderInfo.orderNo}}</text>
          <text wx:if="{{item.payTimeText}}" class="gift-order-card__meta">支付时间 {{item.payTimeText}}</text>
        </view>

        <view wx:if="{{item.isPendingPayment}}" class="gift-order-card__actions">
          <view
            class="gift-order-card__action gift-order-card__action--secondary"
            data-id="{{item.id}}"
            catchtap="cancelOrder"
            aria-role="button"
            aria-label="取消订单"
          >取消订单</view>
          <view
            class="gift-order-card__action gift-order-card__action--primary"
            data-id="{{item.id}}"
            catchtap="handlePay"
            aria-role="button"
            aria-label="立即支付"
          >立即支付</view>
        </view>
      </view>

      <view wx:if="{{!filteredOrders.length}}" class="gift-orders-empty">
        <empty-state
          icon="/assets/icons/lucide/gift.svg"
          title="暂无礼品卡订单"
          description="没有符合条件的礼品卡订单"
        />
      </view>
    </view>
  </scroll-view>
</view>