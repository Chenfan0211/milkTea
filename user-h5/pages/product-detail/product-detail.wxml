<view class="product-detail-page">
  <navigation-bar title="商品详情" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <scroll-view class="product-detail-scroll" scroll-y show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="product-detail-state">
      <empty-state icon="/assets/icons/lucide/file-search-brand.svg" title="加载中" description="正在获取商品详情" />
    </view>

    <view wx:elif="{{missing}}" class="product-detail-state">
      <empty-state icon="/assets/icons/lucide/circle-alert-warning.svg" title="商品不存在" description="商品编号缺失或该商品已被移除" />
    </view>

    <view wx:elif="{{error}}" class="product-detail-state">
      <empty-state icon="/assets/icons/lucide/circle-alert-warning.svg" title="加载失败" description="{{error}}" />
      <view class="product-detail-retry" bindtap="load" aria-role="button" aria-label="重新加载商品详情">重新加载</view>
    </view>

    <view wx:else class="product-detail-content">
      <view class="product-detail-hero">
        <image wx:if="{{product.image}}" class="product-detail-hero__image" src="{{product.image}}" mode="aspectFit" aria-label="{{product.name}}" />
        <view wx:else class="product-detail-hero__empty">
          <image class="product-detail-hero__empty-icon" src="/assets/icons/lucide/image.svg" mode="aspectFit" />
          <text class="product-detail-hero__empty-text">暂无商品图</text>
        </view>
      </view>
      <text wx:if="{{product.imageDisclaimer}}" class="product-detail-hero__note">{{product.imageDisclaimer}}</text>

      <view class="product-detail-card product-detail-card--main">
        <view class="product-detail-card__head">
          <text class="product-detail-name">{{product.name}}</text>
          <text wx:if="{{product.priceLabel}}" class="product-detail-price-label">{{product.priceLabel}}</text>
        </view>
        <view wx:if="{{product.tags.length}}" class="product-detail-tags">
          <text wx:for="{{product.tags}}" wx:key="*this" class="product-detail-tag">{{item}}</text>
        </view>
        <view class="product-detail-price">
          <text class="product-detail-price__value">¥{{selection.memberPrice}}</text>
          <text wx:if="{{product.originalPriceText}}" class="product-detail-price__original">{{product.originalPriceText}}</text>
        </view>
        <text wx:if="{{product.promotionText}}" class="product-detail-promo">{{product.promotionText}}</text>
        <text wx:if="{{product.description}}" class="product-detail-desc">{{product.description}}</text>
      </view>

      <view wx:if="{{selection.specGroups.length}}" class="product-detail-card">
        <text class="product-detail-card__title">我的口味</text>
        <view wx:for="{{selection.specGroups}}" wx:key="id" class="product-detail-spec">
          <text class="product-detail-spec__label">{{item.label}}</text>
          <view class="product-detail-spec__options">
            <view
              wx:for="{{item.options}}"
              wx:for-item="option"
              wx:key="id"
              class="product-detail-spec__option {{option.selected ? 'is-selected' : ''}}"
              data-group-id="{{item.id}}"
              data-option-id="{{option.id}}"
              bindtap="selectSpecOption"
              aria-role="button"
              aria-label="{{option.label}}"
            >
              <text class="product-detail-spec__option-label">{{option.label}}</text>
              <text wx:if="{{option.priceDelta > 0}}" class="product-detail-spec__option-delta">+¥{{option.priceDelta}}</text>
            </view>
          </view>
        </view>

        <view class="product-detail-quantity">
          <text class="product-detail-quantity__label">购买数量</text>
          <view class="product-detail-quantity__stepper">
            <view class="product-detail-quantity__step {{selection.quantity <= 1 ? 'is-disabled' : ''}}" bindtap="decreaseQuantity" aria-role="button" aria-label="减少数量">
              <image class="product-detail-quantity__icon" src="/assets/icons/lucide/minus.svg" mode="aspectFit" />
            </view>
            <text class="product-detail-quantity__value">{{selection.quantity}}</text>
            <view class="product-detail-quantity__step product-detail-quantity__step--plus" bindtap="increaseQuantity" aria-role="button" aria-label="增加数量">
              <image class="product-detail-quantity__icon" src="/assets/icons/lucide/plus.svg" mode="aspectFit" />
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{product.cupCapacity || product.ingredients || product.allergens}}" class="product-detail-card">
        <text class="product-detail-card__title">商品信息</text>
        <view wx:if="{{product.cupCapacity}}" class="product-detail-row">
          <text class="product-detail-row__label">杯型容量</text>
          <text class="product-detail-row__value">{{product.cupCapacity}}</text>
        </view>
        <view wx:if="{{product.ingredients}}" class="product-detail-row">
          <text class="product-detail-row__label">主要原料</text>
          <text class="product-detail-row__value">{{product.ingredients}}</text>
        </view>
        <view wx:if="{{product.allergens}}" class="product-detail-row">
          <text class="product-detail-row__label">过敏原</text>
          <text class="product-detail-row__value">{{product.allergens}}</text>
        </view>
      </view>

      <view wx:if="{{product.tips.length}}" class="product-detail-card">
        <text class="product-detail-card__title">温馨提示</text>
        <text wx:for="{{product.tips}}" wx:key="*this" class="product-detail-tip">· {{item}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && !missing && !error}}" class="product-detail-bar">
    <text class="product-detail-bar__price">¥{{selection.memberPrice}}</text>
    <view class="product-detail-bar__actions">
      <view class="product-detail-bar__button product-detail-bar__button--cart" bindtap="handleAddCart" aria-role="button" aria-label="加入购物车">加入购物车</view>
      <view class="product-detail-bar__button product-detail-bar__button--buy" bindtap="handleBuyNow" aria-role="button" aria-label="立即购买">立即购买</view>
    </view>
  </view>

</view>
