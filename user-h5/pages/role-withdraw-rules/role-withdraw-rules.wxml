<view class="withdraw-rules-page">
  <navigation-bar title="提现规则" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <scroll-view class="withdraw-rules-scroll" scroll-y show-scrollbar="{{false}}">
    <view wx:if="{{!ready}}" class="withdraw-rules-empty">
      <empty-state title="暂无权限" description="请先开通并选择经营角色" icon="/assets/icons/lucide/users.svg" />
    </view>

    <view wx:else class="withdraw-rules-content">
      <view class="withdraw-rules-lead">
        <text class="withdraw-rules-lead__title">提现说明</text>
        <text class="withdraw-rules-lead__desc">提现额度、手续费与审核标准以平台后台配置为准，以下为当前生效规则。</text>
      </view>

      <view class="withdraw-rules-list">
        <view wx:for="{{ruleItems}}" wx:key="id" class="withdraw-rule">
          <image class="withdraw-rule__icon" src="{{item.icon}}" mode="aspectFit" />
          <view class="withdraw-rule__body">
            <text class="withdraw-rule__title">{{item.title}}</text>
            <text class="withdraw-rule__desc">{{item.description}}</text>
            <text wx:if="{{item.extra}}" class="withdraw-rule__extra">{{item.extra}}</text>
          </view>
        </view>
      </view>

      <view class="withdraw-rules-foot">
        <text wx:for="{{ruleFootnotes}}" wx:key="*this" class="withdraw-rules-foot__line">{{item}}</text>
      </view>
    </view>
  </scroll-view>
</view>