.signin-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--brand-soft);
}

.signin-scroll {
  flex: 1;
  min-height: 0;
  background: linear-gradient(180deg, var(--brand-soft), var(--page-bg-neutral) 1000rpx);
}

.signin-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 420rpx;
  padding: 24rpx var(--page-gutter);
  overflow: hidden;
}

.signin-hero__head {
  display: flex;
  width: 100%;
  align-items: flex-start;
  justify-content: space-between;
}

.signin-hero__title {
  max-width: 420rpx;
  color: var(--text-main);
  font-size: var(--font-display);
  font-weight: 600;
  line-height: 64rpx;
}

.signin-rules-entry {
  display: flex;
  align-items: center;
  height: 48rpx;
  margin-top: 16rpx;
  padding: 0 16rpx;
  color: var(--brand-green);
  font-size: var(--font-sm);
  background: rgba(255, 255, 255, 0.72);
  border-radius: var(--radius-pill);
}

.signin-rules-entry__arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
}

.signin-points-pill {
  display: flex;
  align-items: center;
  height: 56rpx;
  margin-top: 20rpx;
  padding: 0 20rpx;
  color: var(--brand-green);
  font-size: var(--font-md);
  background: var(--card-bg);
  border-radius: var(--radius-pill);
}

.signin-points-pill__icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.signin-hero__calendar {
  position: absolute;
  top: 80rpx;
  right: -28rpx;
  width: 480rpx;
  height: 320rpx;
}

.signin-card,
.signin-rewards-card {
  margin: 0 var(--page-gutter) 20rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.signin-card {
  margin-top: -24rpx;
}

.signin-card__title {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.signin-card__days {
  color: var(--brand-green);
  font-size: var(--font-display);
}

.signin-card__hint {
  display: block;
  margin-top: 16rpx;
  color: var(--brand-green);
  font-size: var(--font-md);
}

.signin-week {
  display: flex;
  margin-top: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--brand-soft);
  border-radius: var(--radius-sm);
}

.signin-week__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 0 4rpx 12rpx;
  border-right: 1rpx solid var(--brand-soft);
  background: var(--card-bg);
}

.signin-week__item:last-child {
  border-right: 0;
}

.signin-week__item.is-signed {
  background: var(--brand-soft);
}

.signin-week__date {
  width: 100%;
  padding: 4rpx 0;
  color: var(--text-secondary);
  font-size: var(--font-caption);
  text-align: center;
  background: var(--brand-soft);
}

.signin-week__item.is-signed .signin-week__date {
  color: #FFFFFF;
  background: var(--brand-green);
}

.signin-week__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-top: 4rpx;
}

.signin-week__icon {
  width: 32rpx;
  height: 32rpx;
}

.signin-week__reward {
  color: var(--text-muted);
  font-size: var(--font-caption);
}

.signin-week__calendar {
  justify-content: center;
}

.signin-week__calendar-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.signin-week__calendar-label {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  color: var(--brand-green);
  font-size: var(--font-caption);
}

.signin-week__calendar-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 2rpx;
}

.signin-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-top: 20rpx;
  color: #FFFFFF;
  font-size: var(--font-lg);
  font-weight: 600;
  background: var(--brand-green);
  border-radius: var(--radius-md);
}

.signin-submit.is-disabled {
  color: var(--brand-green);
  background: var(--brand-tint);
}

.signin-prizes {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: var(--text-secondary);
  font-size: var(--font-md);
}

.signin-prizes__arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
}

.signin-rewards-card__title {
  display: block;
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.signin-reward {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.signin-reward + .signin-reward {
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line-color);
}

.signin-reward__coin {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: var(--brand-green);
  font-size: var(--font-lg);
  font-weight: 600;
  background: var(--brand-soft);
  border-radius: 50%;
}

.signin-reward__coin-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--brand-soft);
  border-radius: 50%;
}

.signin-reward__gift {
  width: 40rpx;
  height: 40rpx;
}

.signin-reward__copy {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.signin-reward__title {
  display: block;
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.signin-reward__desc {
  display: block;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.signin-reward__status {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 48rpx;
  color: #FFFFFF;
  font-size: var(--font-sm);
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}

.signin-reward__status.is-done {
  color: var(--brand-green);
  background: var(--brand-tint);
}

.signin-rewards-card__expand {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.signin-rewards-card__expand-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
  transition: transform 0.2s;
}

.signin-rewards-card__expand-icon.is-expanded {
  transform: rotate(180deg);
}

.signin-safe {
  height: calc(20rpx + env(safe-area-inset-bottom));
}

.signin-modal,
.signin-calendar-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.46);
}

.signin-modal {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
}

.signin-modal__panel {
  width: 100%;
  padding: 40rpx 24rpx 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
}

.signin-modal__title {
  display: block;
  color: var(--text-main);
  font-size: var(--font-xl);
  font-weight: 600;
  text-align: center;
}

.signin-modal__reward {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  margin-top: 32rpx;
  color: var(--text-main);
  font-size: var(--font-lg);
  background: var(--brand-soft);
  border-radius: var(--radius-md);
}

.signin-modal__star {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.signin-modal__close {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-top: 32rpx;
  color: #FFFFFF;
  font-size: var(--font-lg);
  font-weight: 600;
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}

.signin-calendar-mask {
  display: flex;
  align-items: flex-end;
}

.signin-calendar-sheet {
  width: 100%;
  max-height: 86vh;
  padding: 24rpx var(--page-gutter) calc(24rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  background: var(--card-bg);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.signin-calendar-sheet__head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
}

.signin-calendar-sheet__title {
  color: var(--text-main);
  font-size: var(--font-xl);
  font-weight: 600;
}

.signin-calendar-sheet__close {
  position: absolute;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
}

.signin-calendar-sheet__close image {
  width: 36rpx;
  height: 36rpx;
}

.signin-calendar-sheet__month {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  margin-top: 16rpx;
  color: var(--brand-green);
  font-size: var(--font-lg);
  background: var(--brand-soft);
  border-radius: var(--radius-sm);
}

.signin-calendar-sheet__month-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
}

.signin-calendar-sheet__month-button image {
  width: 32rpx;
  height: 32rpx;
}

.signin-calendar-weekdays,
.signin-calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.signin-calendar-weekdays {
  margin-top: 16rpx;
}

.signin-calendar-weekdays text {
  width: calc(100% / 7);
  color: var(--text-main);
  font-size: var(--font-md);
  text-align: center;
}

.signin-calendar-grid {
  margin-top: 8rpx;
}

.signin-calendar-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(100% / 7);
  height: 112rpx;
  padding: 4rpx;
}

.signin-calendar-cell.is-empty {
  opacity: 0;
}

.signin-calendar-cell:not(.is-empty) {
  border: 1rpx solid var(--brand-soft);
}

.signin-calendar-cell.is-signed {
  background: var(--brand-soft);
}

.signin-calendar-cell__date {
  color: var(--text-secondary);
  font-size: var(--font-caption);
}

.signin-calendar-cell.is-signed .signin-calendar-cell__date {
  color: var(--brand-green);
}

.signin-calendar-cell__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
}

.signin-calendar-cell__icon-wrap image {
  width: 28rpx;
  height: 28rpx;
}

.signin-calendar-cell.is-signed .signin-calendar-cell__icon-wrap {
  background: var(--brand-green);
  border-radius: 50%;
}

.signin-calendar-cell__reward {
  color: var(--brand-green);
  font-size: var(--font-caption);
}
