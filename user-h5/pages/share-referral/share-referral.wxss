.share-referral-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg);
}

.share-referral-scroll {
  flex: 1;
  min-height: 0;
}

.share-referral-content {
  padding: 24rpx var(--page-gutter) calc(40rpx + env(safe-area-inset-bottom));
}

.progress-card,
.reward-card,
.earning-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}


.progress-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-card__title {
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.progress-card__count {
  color: var(--brand-green);
  font-size: var(--font-sm);
}

.progress-card__track {
  height: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
  background: var(--page-bg);
  border-radius: var(--radius-pill);
}

.progress-card__value {
  height: 100%;
  background: var(--brand-green);
  border-radius: var(--radius-pill);
}

.progress-card__hint {
  display: block;
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: var(--font-caption);
  line-height: 32rpx;
}

.reward-card__title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.reward-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.reward-row + .reward-row {
  border-top: 1rpx solid var(--line-color);
}

.reward-row__icon {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.reward-row__body {
  flex: 1;
  min-width: 0;
}

.reward-row__title {
  display: block;
  color: var(--text-main);
  font-size: var(--font-base);
  font-weight: 600;
}

.reward-row__desc {
  display: block;
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 36rpx;
}

.earning-card__label {
  display: block;
  color: var(--text-main);
  font-size: var(--font-md);
  font-weight: 600;
}

.earning-card__text {
  display: block;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 36rpx;
}

.share-referral-bar {
  flex: none;
  padding: 20rpx var(--page-gutter) calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top: 1rpx solid var(--line-color);
}

/*
 * 邀请按钮（原生 button）。
 *
 * 为什么用原生 button：微信只允许 button open-type="share" 触发「点击即分享」，
 * view + bindtap 无法唤起分享面板（平台硬性限制）。
 *
 * 为什么按下述方式重置：原生 button 自带 padding / 边框 / ::after 伪元素，
 * 会与设计系统冲突（这也是规范默认禁用 button 的原因）。
 * 这里保留设计系统的视觉（80rpx 高 / 品牌绿 / 胶囊圆角），
 * 只把 button 的默认装饰清零 —— 与 pages/service 的客服按钮同一做法。
 */
.share-referral-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  padding: 0;
  color: #ffffff;
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 80rpx;
  background: var(--brand-green);
  border: none;
  border-radius: var(--radius-pill);
}

/* 清除 button 默认的 ::after 边框（不重置会在按钮外圈画一条细边） */
.share-referral-btn::after {
  border: none;
}

.share-referral-btn--pressed {
  background: var(--brand-dark);
}
