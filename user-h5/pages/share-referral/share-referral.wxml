<view class="share-referral-page">
  <navigation-bar title="分享有礼" back="{{true}}" background="#F7F7F7" color="#2F302D" />

  <scroll-view class="share-referral-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="share-referral-content">
      <view class="progress-card">
        <view class="progress-card__head">
          <text class="progress-card__title">邀请进度</text>
          <text class="progress-card__count">已邀请 {{invitedCount}} 人</text>
        </view>
        <view class="progress-card__track">
          <view class="progress-card__value" style="width: {{invitedCount * 10}}%;"></view>
        </view>
        <text class="progress-card__hint">{{upgradeHint}}</text>
      </view>

      <view class="reward-card">
        <text class="reward-card__title">奖励规则</text>
        <view wx:for="{{rewards}}" wx:key="id" class="reward-row">
          <image class="reward-row__icon" src="{{item.id === 'social-star' ? '/assets/icons/lucide/award.svg' : item.id === 'recommender' ? '/assets/icons/lucide/medal.svg' : '/assets/icons/lucide/gift-brand.svg'}}" mode="aspectFit" />
          <view class="reward-row__body">
            <text class="reward-row__title">{{item.title}}</text>
            <text class="reward-row__desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <view class="earning-card">
        <text class="earning-card__label">到账规则</text>
        <text class="earning-card__text">{{earningNote}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="share-referral-bar">
    <!--
      微信小程序里「点击即分享」只能由 button open-type="share" 触发，
      view + bindtap 无法唤起分享面板（这是平台硬性限制，与客服会话同理）。
      按钮默认样式（含 ::after 边框）已在 wxss 中重置，不污染设计系统。
    -->
    <button
      class="share-referral-btn"
      open-type="share"
      hover-class="share-referral-btn--pressed"
      aria-role="button"
      aria-label="邀请好友"
    >
      <text>立即邀请好友</text>
    </button>
  </view>
</view>
