<view class="service-page">
  <navigation-bar title="客服中心" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <scroll-view class="service-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="service-content">
      <view class="service-contact-card">
        <view class="service-contact__head">
          <view class="service-contact__head-icon">
            <image class="service-contact__head-image" src="/assets/icons/lucide/headset.svg" mode="aspectFit" />
          </view>
          <view class="service-contact__heading">
            <text class="service-contact__title">联系客服</text>
            <text wx:if="{{serviceHours}}" class="service-contact__hours">服务时间 {{serviceHours}}</text>
          </view>
        </view>

        <view class="service-contact__online">
          <text class="service-contact__section-title">在线客服</text>
          <text class="service-contact__desc">{{onlineNote}}</text>
          <!-- 微信原生客服会话必须使用 button open-type="contact"，无法用 view 替代 -->
          <button
            class="service-contact__button"
            open-type="contact"
            aria-role="button"
            aria-label="联系在线客服"
          >联系客服</button>
        </view>

        <view class="service-contact__divider"></view>

        <view
          wx:if="{{info.hotline}}"
          class="service-contact__hotline"
          data-phone="{{info.hotline}}"
          bindtap="callPhone"
          aria-role="button"
          aria-label="拨打客服热线"
        >
          <view class="service-contact__hotline-icon">
            <image class="service-contact__hotline-image" src="/assets/icons/lucide/phone.svg" mode="aspectFit" />
          </view>
          <view class="service-contact__hotline-body">
            <text class="service-contact__hotline-label">客服热线</text>
            <text class="service-contact__hotline-number">{{info.hotline}}</text>
          </view>
          <text class="service-contact__hotline-action">拨打</text>
        </view>
        <text wx:elif="{{loadFailed}}" class="service-contact__hotline-tip">客服热线加载失败，可通过在线客服联系我们。</text>
        <text wx:else class="service-contact__hotline-tip">客服热线暂未配置，可通过在线客服联系我们。</text>

        <text wx:if="{{info.responseNote}}" class="service-contact__response">{{info.responseNote}}</text>
      </view>

      <view class="service-card">
        <view class="service-card__head">
          <image class="service-card__icon" src="/assets/icons/lucide/circle-help.svg" mode="aspectFit" />
          <text class="service-card__title">常见问题</text>
        </view>
        <text wx:if="{{loaded && !faqs.length}}" class="service-tip">暂无常见问题，可通过在线客服咨询。</text>
        <view
          wx:for="{{faqs}}"
          wx:key="id"
          class="faq-item {{expandedFaqId === item.id ? 'is-open' : ''}}"
          data-id="{{item.id}}"
          bindtap="toggleFaq"
          aria-role="button"
          aria-label="{{item.question}}"
        >
          <view class="faq-item__head">
            <text class="faq-item__question">{{item.question}}</text>
            <image class="faq-item__arrow" src="/assets/icons/lucide/chevron-down.svg" mode="aspectFit" />
          </view>
          <text wx:if="{{expandedFaqId === item.id}}" class="faq-item__answer">{{item.answer}}</text>
        </view>
      </view>

      <view class="service-card">
        <view class="service-card__head">
          <image class="service-card__icon" src="/assets/icons/lucide/store-brand.svg" mode="aspectFit" />
          <text class="service-card__title">门店电话</text>
        </view>
        <view
          wx:for="{{storeList}}"
          wx:key="id"
          class="service-row service-row--store"
          data-phone="{{item.phone}}"
          bindtap="callPhone"
          aria-role="button"
          aria-label="拨打{{item.name}}电话"
        >
          <view class="service-row__body">
            <text class="service-row__label">{{item.name}}</text>
            <text class="service-row__meta">{{item.businessHours}}</text>
          </view>
          <text class="service-row__action">{{item.phone}}</text>
        </view>
      </view>

      <view class="service-safe"></view>
    </view>
  </scroll-view>
</view>