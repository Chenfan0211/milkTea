.store-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg-neutral);
}

.store-filter {
  display: flex;
  flex: none;
  align-items: center;
  min-height: 96rpx;
  padding: 0 var(--page-gutter);
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--line-color);
}

.store-filter__location {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.store-filter__pin {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}

.store-filter__address {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
  color: var(--text-main);
  font-size: var(--font-base);
}

.store-filter__arrow {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-left: 4rpx;
}

.store-filter__city {
  display: flex;
  flex: none;
  align-items: center;
  height: 64rpx;
  margin-left: 20rpx;
  padding: 0 20rpx;
  color: var(--text-secondary);
  font-size: var(--font-base);
  background: var(--page-bg-neutral);
  border-radius: var(--radius-md);
}

.store-filter__city-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 4rpx;
}

.store-scroll {
  flex: 1;
  min-height: 0;
}

.store-page__list {
  padding: 20rpx var(--page-gutter) calc(20rpx + env(safe-area-inset-bottom));
}
