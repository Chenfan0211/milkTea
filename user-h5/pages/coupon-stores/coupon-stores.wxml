<view class="store-page">
  <navigation-bar title="{{title}}" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <view class="store-filter">
    <view class="store-filter__location" data-label="选择定位地址" bindtap="showUnavailable" aria-role="button" aria-label="选择定位地址">
      <image class="store-filter__pin" src="/assets/icons/lucide/map-pinned.svg" mode="aspectFit" />
      <text class="store-filter__address ellipsis">{{currentAddress}}</text>
      <image class="store-filter__arrow" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" />
    </view>
    <view class="store-filter__city" data-label="选择城市" bindtap="showUnavailable" aria-role="button" aria-label="选择城市">
      <text>{{currentCity}}</text>
      <image class="store-filter__city-arrow" src="/assets/icons/lucide/chevron-down.svg" mode="aspectFit" />
    </view>
  </view>

  <scroll-view class="store-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="store-page__list">
      <store-list-card
        wx:for="{{stores}}"
        wx:key="id"
        store="{{item}}"
        selected="{{item.id === selectedStoreId}}"
        bind:select="handleSelectStore"
        bind:phone="handlePhone"
        bind:navigate="handleNavigate"
      />
    </view>
  </scroll-view>
</view>
