<view class="favorite-page">
  <navigation-bar title="收藏门店" back="{{true}}" background="#FFFFFF" color="#2F302D" />

  <view class="favorite-page__summary">
    <text class="favorite-page__city">{{currentCityName}}</text>
    <text class="favorite-page__count">{{favoriteStores.length}} 家收藏</text>
  </view>

  <scroll-view class="favorite-page__scroll" scroll-y enhanced="{{false}}" show-scrollbar="{{false}}">
    <view class="favorite-page__list">
      <store-list-card
        wx:for="{{favoriteStores}}"
        wx:key="id"
        store="{{item}}"
        selected="{{item.id === currentStoreId}}"
        favorite-interactive="{{true}}"
        bind:select="handleSelectFavoriteStore"
        bind:favorite="handleRemoveFavorite"
        bind:phone="handlePhone"
        bind:navigate="handleNavigate"
      />

            <empty-state
        wx:if="{{!favoriteStores.length}}"
        title="当前城市暂无收藏门店"
        description="返回点单页，点击门店名称前的五角星即可收藏"
        icon="/assets/icons/lucide/star.svg"
      />
    </view>
  </scroll-view>
</view>
