.favorite-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg-neutral);
}

.favorite-page__summary {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 var(--page-gutter);
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--line-color);
}

.favorite-page__city {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.favorite-page__count {
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.favorite-page__scroll {
  flex: 1;
  min-height: 0;
}

.favorite-page__list {
  padding: 20rpx var(--page-gutter) calc(20rpx + env(safe-area-inset-bottom));
}
