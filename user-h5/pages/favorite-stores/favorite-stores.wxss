.favorite-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg-neutral);
}

.favorite-page__summary {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 var(--page-gutter);
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--line-color);
}

.favorite-page__city {
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
}

.favorite-page__count {
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.favorite-page__scroll {
  flex: 1;
  min-height: 0;
}

.favorite-page__list {
  padding: 20rpx var(--page-gutter) calc(20rpx + env(safe-area-inset-bottom));
}

.favorite-store {
  padding: 24rpx;
  background: var(--brand-soft);
  border: 2rpx solid transparent;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.favorite-store + .favorite-store {
  margin-top: 20rpx;
}

.favorite-store__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.favorite-store__name {
  flex: 1;
  min-width: 0;
  color: var(--text-main);
  font-size: var(--font-lg);
  font-weight: 600;
  line-height: 40rpx;
}

.favorite-store__star {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: -8rpx -8rpx 0 16rpx;
}

.favorite-store__star image {
  width: 34rpx;
  height: 34rpx;
}

.favorite-store__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.favorite-store__distance {
  color: var(--text-main);
  font-size: var(--font-base);
  line-height: 34rpx;
}

.favorite-store__queue {
  display: flex;
  align-items: center;
  font-size: var(--font-sm);
  line-height: 32rpx;
}

.favorite-store__queue image {
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
}

.favorite-store__address {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--text-main);
  font-size: var(--font-base);
  line-height: 36rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.favorite-store__hours {
  display: block;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 32rpx;
}
