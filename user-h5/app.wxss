page {
  /* 品牌色 */
  --brand-green: #53882c;
  --brand-dark: #3f6e1f;
  --brand-soft: #e9f1d9;
  --brand-tint: #e7f0d8;
  /* 中性色 */
  --page-bg: #f4f5f2;
  --page-bg-neutral: #f7f7f7;
  --card-bg: #ffffff;
  --text-main: #2f302d;
  --text-secondary: #777873;
  --text-muted: #9b9b96;
  --line-color: #e9eae5;
  --dark-fill: #2d2d2d;
  /* 功能色 */
  --accent-orange: #c65a1e;
  --queue-warning: #e6a23c;
  --favorite-gold: #d4a017;
  --price-red: #ff0000;
  --tag-hot-bg: #ffe0e1;
  --tag-light-bg: #d5f0c3;
  --tag-light-text: #6e9b45;
  --tag-gold-text: #9a6b00;
  --tag-gold-bg: #fff8df;
  --tag-gold-bg-strong: #fff3b8;
  /* 门店卡 · 方案 D 鲜绿活力风（参考图固化值） */
  --store-page-mint: #eaf4e1;
  --store-card-title: #245c2b;
  --store-card-ink: #75886a;
  --store-card-accent: #2e8b40;
  --store-pill-bg: #edf5e2;
  --store-promo-from: #429e46;
  --store-promo-to: #2e7d3a;
  --store-action-from: #3b9544;
  --store-action-to: #32843d;
  --store-decor-leaf: #a6c685;
  /* 字号档位 */
  --font-caption: 20rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 38rpx;
  --font-display: 48rpx;
  /* 圆角档位 */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-pill: 999rpx;
  /* 阴影档位 */
  --shadow-card: 0 8rpx 28rpx rgba(49, 73, 28, 0.06);
  --shadow-float: 0 12rpx 30rpx rgba(0, 0, 0, 0.22);
  /* 尺寸 */
  --tabbar-height: 112rpx;
  /* 购物车浮条高度：与 components/cart-bar/cart-bar.wxss 的 .cart-bar-dock height 一致，
     点单页底部留白依赖该值，改一处即可同步生效 */
  --cart-bar-height: 114rpx;
  /* 自定义导航栏高度：与 navigation-bar.js 中「胶囊按钮上下留白 + 按钮高度」的口径一致 */
  --nav-bar-height: 88rpx;
  --page-gutter: 20rpx;
  min-height: 100%;
  background: var(--page-bg);
  color: var(--text-main);
  font-family: 'PingFang SC', 'HarmonyOS Sans SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
}

view,
scroll-view,
image,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  background: var(--page-bg);
}

.page-scroll {
  min-height: 100vh;
}

.tabbar-safe-space {
  height: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
}

.card {
  background: var(--card-bg);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}

.section-title {
  color: var(--text-main);
  font-size: 34rpx;
  font-weight: 600;
}

.primary-text {
  color: var(--brand-green);
}

.muted-text {
  color: var(--text-secondary);
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
