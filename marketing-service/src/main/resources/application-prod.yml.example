# =============================================================
# 营销服务生产配置
# =============================================================
server:
  # 只监听回环：由 gateway(8080) 统一对外
  address: 127.0.0.1
  port: 8083
  error:
    include-message: never
    include-stacktrace: never
    include-binding-errors: never

spring:
  application:
    name: wuling-marketing-service
  jackson:
    time-zone: Asia/Shanghai
    date-format: yyyy-MM-dd HH:mm:ss
  cloud:
    nacos:
      discovery:
        server-addr: 127.0.0.1:8848
        ip: 127.0.0.1
  datasource:
    # allowPublicKeyRetrieval=true：MySQL 8 caching_sha2_password 在非 SSL 下必需，
    # 缺失会导致 "Public Key Retrieval is not allowed"（曾造成生产 500 故障）
    url: jdbc:mysql://127.0.0.1:3306/wuling?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: ${MYSQL_USER:wuling}
    password: ${MYSQL_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2
      connection-timeout: 3000
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password: ${REDIS_PASSWORD}
      timeout: 3000ms
  rabbitmq:
    host: 127.0.0.1
    port: 5672
    username: ${RABBITMQ_USER:wuling}
    password: ${RABBITMQ_PASSWORD}

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.nologging.NoLoggingImpl
  global-config:
    banner: false
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

management:
  endpoints:
    web:
      exposure:
        include: health
  endpoint:
    health:
      show-details: never
      show-components: never

app:
  # ---------- 微信小程序营销订阅消息 ----------
  wx:
    app-id: ${WX_APP_ID:wx7d78d69cd175812e}
    app-secret: ${WX_APP_SECRET:}
    access-token-url: ${WX_ACCESS_TOKEN_URL:https://api.weixin.qq.com/cgi-bin/token}
    subscribe-send-url: ${WX_SUBSCRIBE_SEND_URL:https://api.weixin.qq.com/cgi-bin/message/subscribe/send}
    http-timeout-ms: ${WX_MINIAPP_HTTP_TIMEOUT_MS:3000}
    subscribe:
      enabled: ${WX_MARKETING_SUBSCRIBE_ENABLED:true}
      points-change:
        template-id: ${WX_POINTS_CHANGE_TEMPLATE_ID:W69-LPXpDxs7pPiN_0I_75I0XqXJWPkL4XYCS26CopM}
        page: ${WX_POINTS_CHANGE_PAGE:pages/points-detail/points-detail}
      points-exchange:
        template-id: ${WX_POINTS_EXCHANGE_TEMPLATE_ID:6DKXp9_Bx4gYaj0CaUeTp6rXyKIF3AZrrmSR5CwHjfE}
        page: ${WX_POINTS_EXCHANGE_PAGE:pages/exchange-records/exchange-records}
      stored-value-recharge:
        template-id: ${WX_STORED_VALUE_RECHARGE_TEMPLATE_ID:uvD7jHuIZ1bpXIA-HfqHXfScW0j2zIYBCYWHR7emFJI}
        page: ${WX_STORED_VALUE_RECHARGE_PAGE:pages/stored-value-records/stored-value-records}
      balance-change:
        template-id: ${WX_BALANCE_CHANGE_TEMPLATE_ID:uvD7jHuIZ1bpXIA-HfqHXQGw6MCweamgsPFK-MIVne0}
        page: ${WX_BALANCE_CHANGE_PAGE:pages/stored-value-records/stored-value-records}
      coupon-arrival:
        template-id: ${WX_COUPON_ARRIVAL_TEMPLATE_ID:en0sN5PvHmq9DyiZIjaH_x5-bGpisdD3boCqMa_wx5g}
        page: ${WX_COUPON_ARRIVAL_PAGE:pages/coupon-list/coupon-list}
      coupon-expiry:
        template-id: ${WX_COUPON_EXPIRY_TEMPLATE_ID:oaeDu3ZTFfzrrPQvFliAMRHdMNg19KW2V8xhvCU5MSo}
        page: ${WX_COUPON_EXPIRY_PAGE:pages/coupon-list/coupon-list}
    coupon-expiry:
      enabled: ${WX_COUPON_EXPIRY_ENABLED:true}
      cron: '${WX_COUPON_EXPIRY_CRON:0 0 10 * * ?}'
      days-before: ${WX_COUPON_EXPIRY_DAYS_BEFORE:3}
      batch-size: ${WX_COUPON_EXPIRY_BATCH_SIZE:500}

  jwt:
    secret: ${JWT_SECRET}
    access-token-ttl: 3600000
    refresh-token-ttl: 604800000
  redis:
    mode: single
    database:
      auth: 0
      sms: 1
      cache: 2
      biz: 3
  mq:
    max-retry: 3
    consumer-concurrency: 2
    prefetch-count: 10

logging:
  level:
    root: INFO
    com.wuling: INFO
    # 请求日志：每次调用的方法/路径/参数(脱敏)/耗时/状态码
    REQUEST: INFO
